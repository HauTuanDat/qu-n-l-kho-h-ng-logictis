<Window x:Class="Quanlykhohanglogicts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quanlykhohanglogicts"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Kho Hàng &amp; Điều Phối Đơn Hàng Logistics"
        Height="760" Width="1240"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Style cho ListView Navigation Item ở Sidebar -->
        <Style x:Key="SidebarListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/> <!-- Cột Sidebar Navigation (rộng rãi, không tràn chữ) -->
            <ColumnDefinition Width="*"/>   <!-- Vùng ContentControl Chính -->
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: SIDEBAR DÙNG LISTVIEW ================= -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid Margin="12,18,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Logo -->
                    <RowDefinition Height="*"/>    <!-- ListView Điều hướng -->
                    <RowDefinition Height="Auto"/> <!-- Thông tin người dùng đăng nhập & Đăng xuất -->
                </Grid.RowDefinitions>

                <!-- 1. LOGO & TÊN DOANH NGHIỆP LOGISTICS -->
                <StackPanel Grid.Row="0" Margin="4,0,4,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#2563EB" Margin="0,0,10,0">
                            <Path Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                  Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="22" Height="22"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LOGIX WMS" FontSize="19" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="SMART LOGISTICS 4.0" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#334155" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- 2. THANH ĐIỀU HƯỚNG SỬ DỤNG LISTVIEW THEO YÊU CẦU -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="txtNavCategoryTitle" Text="PHÂN HỆ NGHIỆP VỤ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="10,6,0,8"/>

                        <ListView x:Name="lvSidebarNavigation"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource SidebarListViewItemStyle}"
                                  SelectionChanged="LvSidebarNavigation_SelectionChanged">
                            
                            <!-- 1. BẢNG TỔNG QUAN -->
                            <ListViewItem x:Name="navItemOverview">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="1. Bảng Tổng Quan" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 2. QUẢN LÝ ĐƠN HÀNG & VẬN ĐƠN -->
                            <ListViewItem x:Name="navItemOrders">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📋" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="2. Quản Lý Đơn Hàng" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Badge Đơn Cần Xử Lý -->
                                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="7,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock x:Name="badgePendingOrders" Text="3" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                    </Border>
                                </Grid>
                            </ListViewItem>

                            <!-- 3. QUẢN LÝ KHO BÃI TOÀN DIỆN (WMS HUB) -->
                            <ListViewItem x:Name="navItemWarehouse">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏢" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="3. Quản Lý Kho Bãi (WMS)" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 4. TRUNG TÂM ĐIỀU PHỐI VẬN TẢI (TMS) -->
                            <ListViewItem x:Name="navItemDeliveryDispatch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚚" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="4. Điều Phối Vận Tải (TMS)" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 5. QUẢN LÝ ĐỘI XE & SHIPPER -->
                            <ListViewItem x:Name="navItemShipper">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🛵" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="5. Đội Xe &amp; Shipper" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 6. QUẢN LÝ HÀNG HOÀN (REVERSE LOGISTICS & RTO) -->
                            <ListViewItem x:Name="navItemReturnManagement">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔄" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="6. Quản Lý Hàng Hoàn" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 7. QUẢN TRỊ HỆ THỐNG & PHÂN QUYỀN (CHỈ ADMIN) -->
                            <ListViewItem x:Name="navItemUsers">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👥" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="7. Quản Trị Hệ Thống" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Ổ khóa nếu không phải admin -->
                                    <TextBlock x:Name="badgeAdminLock" Grid.Column="2" Text="🔒" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </ListViewItem>

                            <!-- 8. TIẾP NHẬN BƯU KIỆN & PHÂN XE (DÀNH CHO NHÂN VIÊN KHO) -->
                            <ListViewItem x:Name="navItemWarehouseCheckIn">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="8. Tiếp Nhận Kho &amp; Phân Xe" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#059669" CornerRadius="8" Padding="5,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="HUB" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </ListViewItem>

                            <!-- ================= CÁC MỤC DÀNH RIÊNG CHO KHÁCH HÀNG & CHỦ SHOP ================= -->
                            <!-- K1. LÊN ĐƠN GIAO HÀNG (LẤY MÃ QR) -->
                            <ListViewItem x:Name="navItemCustCreateOrder" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="1. Lên Đơn Giao Hàng" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>

                            <!-- K2. ĐỊNH VỊ GPS ĐƠN HÀNG -->
                            <ListViewItem x:Name="navItemCustGps" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🛰️" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="2. Định Vị GPS Đơn Hàng" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#8B5CF6" CornerRadius="8" Padding="5,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </ListViewItem>

                            <!-- K3. SỔ BƯU GỬI & VÍ COD -->
                            <ListViewItem x:Name="navItemCustOrders" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="3. Sổ Bưu Gửi &amp; Ví COD" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. THÔNG TIN NGƯỜI DÙNG ĐANG ĐĂNG NHẬP & NÚT ĐĂNG XUẤT -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Avatar & Tên -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="avatarBorder" Width="36" Height="36" CornerRadius="18" Background="#2563EB">
                                <TextBlock x:Name="txtAvatarInitials" Text="AD" Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtCurrentUserName" Text="Nguyễn Văn Quản Trị" Foreground="White" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="badgeRoleContainer" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,3,0,0" Background="#DC2626">
                                    <TextBlock x:Name="txtCurrentUserRole" Text="Quản trị viên" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Nút Đăng Xuất -->
                        <Button x:Name="btnLogout" Grid.Row="1" Margin="0,10,0,0" Height="32" Background="#334155" Foreground="#E2E8F0"
                                BorderThickness="0" Cursor="Hand" Click="BtnLogout_Click" ToolTip="Đăng xuất khỏi hệ thống">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="🚪 Đăng Xuất Hệ Thống" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= CỘT PHẢI: TOPBAR & CONTENTCONTROL NẠP TRANG ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/> <!-- Topbar Header -->
                <RowDefinition Height="*"/>  <!-- ContentControl động -->
            </Grid.RowDefinitions>

            <!-- 1. TOPBAR HEADER -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtCurrentPageTitle" Text="BẢNG TỔNG QUAN HỆ THỐNG" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock Text="Hệ Thống Phân Quyền Hoạt Động" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="txtLoginTimestamp" Text="Đăng nhập lúc: 08:30" Foreground="#64748B" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Border x:Name="borderDbStatus" Background="#DCFCE7" CornerRadius="12" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotDbStatus" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtDbStatus" Text="SQL Server: quanlykho (Đã kết nối)" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. CONTENTCONTROL NẠP CÁC TRANG USERCONTROL ĐỘNG THEO YÊU CẦU -->
            <ContentControl x:Name="MainContentArea" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
