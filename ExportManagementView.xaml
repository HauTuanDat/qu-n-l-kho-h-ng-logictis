<UserControl x:Class="Quanlykhohanglogicts.ExportManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quanlykhohanglogicts"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Style Button Thao Tác Chuẩn -->
        <Style x:Key="NutThaoTacXuatStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="khungVien" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Thẻ KPI -->
        <Style x:Key="TheKpiXuatStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. GIAO DIỆN CHÍNH CUỘN TRANG -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel>

                <!-- ================= HEADER: TIÊU ĐỀ & CÔNG CỤ NHANH ================= -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📤" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Xuất Kho &amp; Bàn Giao Vận Tải (Outbound)" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#FEE2E2" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="XUẤT BẾN &amp; BIÊN BẢN BÀN GIAO" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Kiểm soát toàn bộ bưu kiện rời kho: Xuất giao chặng cuối cho Shipper • Điều xe tải trung chuyển liên tỉnh • In biên bản bàn giao" 
                                   FontSize="12" Foreground="#64748B" Margin="0,4,10,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Nút thao tác nhanh trên Header -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnMoModalLapLenhXuat" Style="{StaticResource NutThaoTacXuatStyle}" Height="38" Padding="14,0" 
                                Background="#2563EB" Foreground="White" Margin="0,0,8,0" Click="BtnMoModalLapLenhXuat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="Xuất Kho" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnInPhieuGanNhat" Style="{StaticResource NutThaoTacXuatStyle}" Height="38" Padding="14,0" 
                                Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Foreground="#0F766E" Margin="0,0,8,0" Click="BtnInPhieuGanNhat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="In Phiếu Xuất Bàn Giao" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnXuatExcelLichSu" Style="{StaticResource NutThaoTacXuatStyle}" Height="38" Padding="12,0" 
                                Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" Margin="0,0,8,0" Click="BtnXuatExcelLichSu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Xuất Báo Cáo Excel" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLamMoiDuLieu" Style="{StaticResource NutThaoTacXuatStyle}" Height="38" Padding="12,0" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Click="BtnLamMoiDuLieu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Nạp Lại" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 4 THẺ KPI XUẤT KHO ================= -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Tổng lệnh xuất hôm nay -->
                    <Border Grid.Column="0" Style="{StaticResource TheKpiXuatStyle}" BorderBrush="#BFDBFE" Background="#EFF6FF">
                        <StackPanel>
                            <TextBlock Text="TỔNG LỆNH XUẤT HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBlock x:Name="txtTongLenhXuatHomNay" Text="0 lệnh" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                            <TextBlock Text="Đã rời bến thành công" FontSize="11" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Xuất giao chặng cuối (Shipper) -->
                    <Border Grid.Column="1" Style="{StaticResource TheKpiXuatStyle}" BorderBrush="#A7F3D0" Background="#F0FDF4">
                        <StackPanel>
                            <TextBlock Text="🛵 XUẤT GIAO CHẶNG CUỐI" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock x:Name="txtXuatShipperCount" Text="0 đơn" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            <TextBlock Text="Bàn giao tài xế giao nội thành" FontSize="11" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Xuất trung chuyển liên tỉnh (Xe tải) -->
                    <Border Grid.Column="2" Style="{StaticResource TheKpiXuatStyle}" BorderBrush="#DDD6FE" Background="#F5F3FF">
                        <StackPanel>
                            <TextBlock Text="🚛 XUẤT TRUNG CHUYỂN LIÊN TỈNH" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                            <TextBlock x:Name="txtXuatTransitCount" Text="0 lô" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                            <TextBlock Text="Xe tải kết nối Hub Thái Nguyên/liên tỉnh" FontSize="11" Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Đơn chờ xuất kho -->
                    <Border Grid.Column="3" Style="{StaticResource TheKpiXuatStyle}" BorderBrush="#FED7AA" Background="#FFFBEB">
                        <StackPanel>
                            <TextBlock Text="📦 ĐƠN CHỜ XUẤT KHO" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock x:Name="txtDonChoXuatKho" Text="0 đơn" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            <TextBlock Text="Đang lưu kho, chờ bốc xếp" FontSize="11" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= THANH TÌM KIẾM & BỘ LỌC ================= -->
                <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ô tìm kiếm nhanh -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,10,0">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBox x:Name="txtTimKiemXuat" Grid.Column="1" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" 
                                         VerticalContentAlignment="Center" FontSize="12.5" TextChanged="TxtTimKiemXuat_TextChanged"/>
                                <TextBlock x:Name="txtTimKiemXuatPlaceholder" Grid.Column="1" Margin="6,0,0,0"
                                           Text="Quét mã vạch hoặc tìm mã đơn (LOGIX-...), mã phiếu xuất, tài xế..." 
                                           FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lọc theo hình thức xuất -->
                        <ComboBox x:Name="cbLocHinhThucXuat" Grid.Column="1" Height="38" FontSize="12" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                  SelectionChanged="CbLocXuatKho_SelectionChanged">
                            <ComboBoxItem Content="-- Tất Cả Hình Thức Xuất --" IsSelected="True"/>
                            <ComboBoxItem Content="🛵 Xuất Giao Chặng Cuối (Shipper)"/>
                            <ComboBoxItem Content="🚛 Xuất Trung Chuyển (Xe Tải Liên Tỉnh)"/>
                        </ComboBox>

                        <!-- Lọc theo tuyến/khu vực -->
                        <ComboBox x:Name="cbLocKhuVucXuat" Grid.Column="2" Height="38" FontSize="12" VerticalContentAlignment="Center"
                                  SelectionChanged="CbLocXuatKho_SelectionChanged">
                            <ComboBoxItem Content="-- Tất Cả Điểm Đến --" IsSelected="True"/>
                            <ComboBoxItem Content="Thái Nguyên"/>
                            <ComboBoxItem Content="Hà Nội"/>
                            <ComboBoxItem Content="Cầu Giấy"/>
                            <ComboBoxItem Content="Hà Đông"/>
                            <ComboBoxItem Content="Đống Đa"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ================= BẢNG DANH SÁCH LỆNH XUẤT KHO ================= -->
                <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="DANH SÁCH LỆNH XUẤT KHO &amp; BÀN GIAO VẬN CHUYỂN" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSoLuongHienThi" Text="Hiển thị: 0 lệnh" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid x:Name="dgLichSuXuatKho" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="48"
                                  Background="White" RowHeaderWidth="0" MaxHeight="520"
                                  SelectionUnit="Cell" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D4ED8"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EFF6FF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1D4ED8"/>
                            </DataGrid.Resources>

                            <!-- Style Cell: Bấm vào ô nào thì DUY NHẤT ô đó đổi màu background, không đổi màu cả dòng -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Khi ô được bấm chuột chọn: Đổi màu background ô này sang xanh nhạt viền xanh -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <!-- Style Row: Giữ background trắng, không đổi màu cả dòng khi có ô được click -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <!-- Không đổi background toàn bộ dòng khi chọn -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Cột 1: Mã giao dịch xuất kho -->
                                <DataGridTextColumn Header="Mã Phiếu Xuất" Binding="{Binding TransactionCode}" FontWeight="Bold" Width="125"/>

                                <!-- Cột 2: Thời điểm xuất kho -->
                                <DataGridTextColumn Header="Thời Điểm Xuất" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                                    FontWeight="SemiBold" Foreground="#2563EB" Width="135"/>

                                <!-- Cột 3: Mã vận đơn tham chiếu -->
                                <DataGridTemplateColumn Header="Mã Đơn / Bưu Kiện" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ReferenceCode}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 4: Hình thức xuất -->
                                <DataGridTemplateColumn Header="Hình Thức Xuất" Width="175">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MovementTypeDisplayName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{Binding MovementTypeColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 5: Bưu kiện xuất -->
                                <DataGridTemplateColumn Header="Bưu Kiện Xuất Kho" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ItemName}" FontSize="12" Foreground="#1E293B" 
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemName}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 6: Bên tiếp nhận -->
                                <DataGridTemplateColumn Header="Bên Tiếp Nhận (Tài Xế / Xe)" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceOrDestination}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" 
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceOrDestination}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 7: Khối lượng -->
                                <DataGridTextColumn Header="Khối Lượng" Binding="{Binding Weight, StringFormat='{}{0:N1} kg'}" Width="90"/>

                                <!-- Cột 8: Thủ kho thực hiện -->
                                <DataGridTextColumn Header="Thủ Kho Xuất" Binding="{Binding OperatorName}" Width="120"/>

                                <!-- Cột 9: Ghi chú xuất kho (Hiển thị đầy đủ chữ, tự ngắt dòng và có Tooltip xem toàn bộ) -->
                                <DataGridTemplateColumn Header="Ghi Chú Xuất Kho" Width="*" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxHeight="42" 
                                                       VerticalAlignment="Center" ToolTip="{Binding Notes}" 
                                                       FontSize="12" Foreground="#334155" LineHeight="16"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 10: Thao tác In Phiếu (Khoảng cách thoáng đãng, căn giữa chuẩn, không bị đè) -->
                                <DataGridTemplateColumn Header="Thao Tác" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NutThaoTacXuatStyle}" Height="30" Padding="12,0" 
                                                        Background="#0D9488" Foreground="White" FontSize="11.5"
                                                        Click="BtnInPhieuRow_Click" ToolTip="In phiếu xuất kho kiêm biên bản bàn giao">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🖨️" Margin="0,0,5,0" FontSize="11"/>
                                                        <TextBlock Text="In Phiếu" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= 2. MODAL POPUP: LẬP LỆNH XUẤT KHO MỚI ================= -->
        <Grid x:Name="gridModalLapLenhXuat" Background="#7F000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Width="680" VerticalAlignment="Center" Padding="24"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <!-- Header Modal -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LẬP LỆNH XUẤT KHO &amp; BÀN GIAO VẬN TẢI" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Ghi nhận bưu kiện rời kho, bàn giao tài xế và cập nhật trạng thái đơn hàng" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕" FontWeight="Bold" FontSize="15" Foreground="#94A3B8" Background="Transparent" 
                                BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="BtnDongModalLapLenh_Click"/>
                    </Grid>

                    <!-- Form nhập liệu -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hình thức xuất -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Hình thức xuất kho (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cbModalHinhThucXuat" Height="38" FontSize="12.5" VerticalContentAlignment="Center"
                                      SelectionChanged="CbModalHinhThucXuat_SelectionChanged">
                                <ComboBoxItem Content="🛵 Xuất giao chặng cuối (Giao Shipper)" IsSelected="True"/>
                                <ComboBoxItem Content="🚛 Xuất trung chuyển liên tỉnh (Xe tải trung chuyển)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Chọn bưu kiện chờ xuất -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Bưu kiện chờ xuất kho (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cbModalDonHangXuat" Height="38" FontSize="12.5" VerticalContentAlignment="Center"
                                      SelectionChanged="CbModalDonHangXuat_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bên tiếp nhận -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tài xế Shipper (Hiện khi chọn Shipper) -->
                        <StackPanel x:Name="panelChonShipper" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tài xế Shipper tiếp nhận (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cbModalShipperTiepNhan" Height="38" FontSize="12.5" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Xe tải trung chuyển (Hiện khi chọn Trung chuyển) -->
                        <StackPanel x:Name="panelXeTaiTrungChuyen" Grid.Column="0" Margin="0,0,10,0" Visibility="Collapsed">
                            <TextBlock Text="Xe tải &amp; Tài xế trung chuyển (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtModalXeTaiTrungChuyen" Height="38" FontSize="12.5" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="Xe tải 29C-889.12 (Tài xế Nguyễn Văn Long - Hub Thái Nguyên)"/>
                        </StackPanel>

