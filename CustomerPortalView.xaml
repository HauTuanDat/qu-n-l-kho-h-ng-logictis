                                            <TextBlock Text="TỐC ĐỘ:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Button x:Name="btnSpeed1x" Content="1x" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Padding="6,2" Margin="0,0,2,0" Cursor="Hand" Click="BtnSpeed1x_Click"/>
                                            <Button x:Name="btnSpeed2x" Content="2x" Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0" FontSize="10" FontWeight="SemiBold" Padding="6,2" Margin="0,0,2,0" Cursor="Hand" Click="BtnSpeed2x_Click"/>
                                            <Button x:Name="btnSpeed4x" Content="4x" Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0" FontSize="10" FontWeight="SemiBold" Padding="6,2" Cursor="Hand" Click="BtnSpeed4x_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- (C) BỘ NÚT ĐIỀU KHIỂN SIMULATION, MÔ TẢ TRẠNG THÁI & NÚT HOÀN TẤT ĐƠN -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="btnPlayGps" Content="▶️ Chạy GPS" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnPlayGps_Click"/>
                                            <Button x:Name="btnPauseGps" Content="⏸️ Tạm Dừng" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnPauseGps_Click"/>
                                            <Button x:Name="btnResetGps" Content="🔄 Về Đầu Kho" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Padding="10,6" Cursor="Hand" Click="BtnResetGps_Click"/>
                                        </StackPanel>

                                        <TextBlock x:Name="txtLiveGpsDescription" Grid.Column="1" Text="Shipper đang di chuyển từ kho Hub Tuấn Đạt..." FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>

                                        <Button x:Name="btnMarkDeliveredGps" Grid.Column="2" Content="🎯 Báo Giao Thành Công" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="12,6" Cursor="Hand" Click="BtnMarkDeliveredGps_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- NỘI DUNG TAB 4: 📊 SỔ BƯU GỬI & ĐỐI SOÁT COD CỦA CHỦ SHOP                 -->
                <!-- ========================================================================= -->
                <Grid x:Name="gridTabOrderList" Visibility="Collapsed">
                    <Border Style="{StaticResource WhiteCardStyle}" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="DANH SÁCH BƯU GỬI &amp; ĐỐI SOÁT TIỀN THU HỘ COD" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Theo dõi trạng thái tiếp nhận kho, phân xe và dòng tiền thu hộ của từng bưu gửi" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Nút xuất Excel / Làm mới -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnRefreshShopOrders" Content="🔄 Làm Mới Dữ Liệu" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefreshShopOrders_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bộ lọc -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSearchShopOrders" Style="{StaticResource ModernTextBoxStyle}" FontSize="13" Padding="10,7" TextChanged="TxtSearchShopOrders_TextChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <ComboBox x:Name="cboFilterShopStatus" Height="36" Width="180" FontSize="12.5" SelectionChanged="CboFilterShopStatus_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                                        <ComboBoxItem Content="Mới tạo (Chưa tới kho)"/>
                                        <ComboBoxItem Content="Đang giao hàng (GPS)"/>
                                        <ComboBoxItem Content="Đã giao thành công"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid danh sách bưu gửi của Shop -->
                            <DataGrid x:Name="dgShopOrders" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9" RowHeight="48" BorderThickness="1" BorderBrush="#E2E8F0"
                                      Background="White" RowHeaderWidth="0" FontSize="12.5">
                                <DataGrid.Columns>
                                    <!-- Mã đơn -->
                                    <DataGridTextColumn Header="MÃ VẬN ĐƠN" Binding="{Binding OrderCode}" FontWeight="Bold" Width="140"/>
                                    
                                    <!-- Người nhận & SĐT -->
                                    <DataGridTemplateColumn Header="NGƯỜI NHẬN" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReceiverName}" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding ReceiverPhone}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Địa chỉ phát -->
                                    <DataGridTextColumn Header="ĐỊA CHỈ PHÁT HÀNG" Binding="{Binding ReceiverAddress}" Width="240"/>

                                    <!-- Phân luồng bưu kiện -->
                                    <DataGridTemplateColumn Header="PHÂN LUỒNG XE" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RoutingCategoryBadgeBackground}" BorderBrush="{Binding RoutingCategoryBorderColor}" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoutingCategoryTag}" FontSize="11" FontWeight="Bold" Foreground="{Binding RoutingCategoryTextColor}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Tiếp nhận kho -->
                                    <DataGridTemplateColumn Header="TIẾP NHẬN KHO" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WarehouseAssignedVehicle, TargetNullValue='Chưa nhập kho'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Trạng thái đơn -->
                                    <DataGridTemplateColumn Header="TRẠNG THÁI GIAO" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusColor, StringFormat='{}{0}20'}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusDisplayName}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- COD Amount -->
                                    <DataGridTextColumn Header="THU HỘ COD" Binding="{Binding CodAmount, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="#047857" Width="110"/>

                                    <!-- Thao tác -->
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🛰️ Xem GPS" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" Click="BtnRowViewGps_Click"/>
                                                    <Button Content="🏷️ In Tem" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,3" Cursor="Hand" Click="BtnRowPrintLabel_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- MODAL TIẾP NHẬN BƯU GỬI ĐIỆN TỬ & MÃ QR XUẤT TRÌNH TẠI KHO                -->
        <!-- Khách hàng KHÔNG cần in phiếu giấy, chỉ cần bấm OK & đưa mã QR cho kho    -->
        <!-- ========================================================================= -->
        <Grid x:Name="modalOrderCreatedSuccess" Visibility="Collapsed" Background="#80000000">
            <Border Width="520" MaxHeight="820" Background="White" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="✓ THÀNH CÔNG" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                </Border>
                                <TextBlock Text="🎉 TẠO ĐƠN HÀNG THÀNH CÔNG!" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Thẻ bưu gửi điện tử • Xuất trình mã bưu kiện hoặc mã QR tại Hub Tuấn Đạt" FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Content="✕" FontSize="16" Foreground="#64748B" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="BtnSuccessClose_Click"/>
                    </Grid>

                    <!-- Thân Modal: Mã QR to rõ & Thông tin đơn -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Khung Mã QR Trung Tâm & Mã Vận Đơn -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14" Padding="16" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="MÃ VẬN ĐƠN ĐIỆN TỬ (ORDER CODE)" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    
                                    <!-- Mã vận đơn lớn & nút copy -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock x:Name="txtSuccessOrderCode" Text="LOGIX-SHOP-261007-001" FontSize="20" FontWeight="Black" Foreground="#2563EB" VerticalAlignment="Center"/>
                                        <Button x:Name="btnCopySuccessOrderCode" Content="📋 Sao chép" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#93C5FD" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Padding="8,4" Margin="10,0,0,0" Cursor="Hand" Click="BtnCopySuccessOrderCode_Click"/>
                                    </StackPanel>

                                    <!-- QR Code to, sắc nét -->
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="12" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Image x:Name="imgSuccessQrCode" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock Text="📱 Đưa mã QR này cho nhân viên kho quét tiếp nhận" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Hướng dẫn kho bãi thực tế (Nhấn mạnh KHÔNG cần in phiếu) -->
                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💡" FontSize="16" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Quý khách KHÔNG CẦN in phiếu giấy!" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                                        <TextBlock Text="Chỉ cần mang gói hàng đến Kho Hub Tuấn Đạt (Dốc đối diện TT học liệu, P. Phan Đình Phùng, TP Thái Nguyên) và xuất trình mã QR này trên điện thoại/màn hình. Nhân viên kho sẽ quét để kiểm tra hợp lệ, xác nhận địa chỉ và phân xe ngay." FontSize="11.5" Foreground="#047857" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tóm tắt chi tiết gói hàng -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Người nhận -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Người nhận:" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtSuccessReceiver" Text="Hoàng Thu Hà • 0915 222 333" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>

                                    <!-- Địa chỉ nhận -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Địa chỉ giao:" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtSuccessReceiverAddress" Text="Số 45 Đường Hoàng Văn Thụ, TP Thái Nguyên" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <!-- Hàng hóa & COD -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hàng &amp; COD:" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="txtSuccessProduct" Text="Hạt SmartHeart (2.0 kg)" FontSize="12" Foreground="#0F172A" Margin="0,0,10,0"/>
                                        <TextBlock Text="• Thu hộ COD: " FontSize="12" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtSuccessCod" Text="350.000 đ" FontSize="12.5" FontWeight="Bold" Foreground="#047857"/>
                                    </StackPanel>

                                    <!-- Phân luồng điều phối -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Phân luồng:" FontSize="11.5" Foreground="#64748B"/>
                                    <Border Grid.Row="3" Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left">
                                        <TextBlock x:Name="txtSuccessRouting" Text="🛵 Tuyến Nội Vùng (Giao ngay trong ca)" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Nút Bấm Duy Nhất: OK -->
                    <StackPanel Grid.Row="2">
                        <Button x:Name="btnSuccessOk" Style="{StaticResource ActionButtonStyle}" Height="46" Background="#059669" Cursor="Hand" Click="BtnSuccessOk_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ ĐÃ HIỂU &amp; HOÀN TẤT (OK)" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL IN TEM NHÃN NHIỆT VẬN ĐƠN CHUẨN 100x150MM (BARCODE & QR CODE)       -->
        <!-- ========================================================================= -->
        <Grid x:Name="modalPrintThermalLabel" Visibility="Collapsed" Background="#80000000">
            <Border Width="450" MaxHeight="800" Background="White" CornerRadius="14" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🏷️ TEM NHÃN VẬN ĐƠN TIÊU CHUẨN 100x150MM" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Dán trực tiếp lên kiện hàng để tài xế lấy và giao ngay" FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Content="✕" FontSize="16" Foreground="#64748B" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="BtnCloseThermalModal_Click"/>
                    </Grid>

                    <!-- TEM NHÃN IN (PrintVisual Target) -->
                    <Border Grid.Row="1" x:Name="borderLabelToPrint" Width="380" Background="White" BorderBrush="#000000" BorderThickness="2" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Dòng Header Thương Hiệu & Mã Phân Luồng -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TUẤN ĐẠT GIAO HÀNG NHANH" FontSize="14" FontWeight="Black" Foreground="Black"/>
                                    <TextBlock Text="Hotline: 1900 8888 • Hub Thái Nguyên" FontSize="9.5" Foreground="#333333"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="Black" Padding="8,4" CornerRadius="4">
                                    <TextBlock Text="B208A28 003" FontSize="13" FontWeight="Black" Foreground="White"/>
                                </Border>
                            </Grid>

                            <Rectangle Height="2" Fill="Black" Margin="0,0,0,8"/>

                            <!-- Barcode Vạch & Số Vận Đơn -->
                            <Image x:Name="imgThermalBarcode" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtThermalOrderCode" Text="LOGIX-SHOP-261006-001" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Black" Margin="0,0,0,8"/>

                            <Rectangle Height="1" Fill="#000000" Margin="0,0,0,8"/>

                            <!-- Thông tin Bên Gửi -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="TỪ: " FontWeight="Bold" FontSize="10" Foreground="Black"/>
                                <TextBlock x:Name="txtThermalSender" Text="Shop ChunsHousepetFood (0978 999 888)" FontSize="10" Foreground="Black" Margin="26,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="txtThermalSenderAddr" Text="Dốc đối diện TT học liệu, Phan Đình Phùng, TP Thái Nguyên" FontSize="9.5" Foreground="#333333" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <Rectangle Height="1" Fill="#CCCCCC" Margin="0,0,0,8"/>

                            <!-- Thông tin Bên Nhận (Đặc Biệt Nổi Bật) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="ĐẾN: " FontWeight="Black" FontSize="11" Foreground="Black"/>
                                <TextBlock x:Name="txtThermalReceiver" Text="Hoàng Thu Hà - 0915 222 333" FontSize="11.5" FontWeight="Bold" Foreground="Black" Margin="34,0,0,0"/>
                            </Grid>
                            <Border Background="#F1F5F9" Padding="6" CornerRadius="4" Margin="0,0,0,8">
                                <TextBlock x:Name="txtThermalReceiverAddr" Text="Số 45 Đường Hoàng Văn Thụ, P. Phan Đình Phùng, TP Thái Nguyên" FontSize="11" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                            </Border>

                            <Rectangle Height="1" Fill="#000000" Margin="0,0,0,8"/>

                            <!-- Thông tin Hàng & COD & QR Code -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NỘI DUNG HÀNG HÓA:" FontSize="9.5" FontWeight="Bold" Foreground="Black"/>
                                    <TextBlock x:Name="txtThermalProduct" Text="Thức ăn thú cưng Poodle (2.0 kg)" FontSize="10" Foreground="#333333" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                    <Border Background="Black" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left">
                                        <TextBlock x:Name="txtThermalCod" Text="COD: 350.000 VNĐ" FontSize="12" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Mã QR Code kiểm tra nhanh -->
                                <Image x:Name="imgThermalQrCode" Grid.Column="1" Width="75" Height="75" Stretch="Uniform" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="Black" Margin="0,0,0,6"/>

                            <!-- Ghi chú cam kết -->
                            <TextBlock Text="CHỈ DẪN: CHO XEM HÀNG - KHÔNG CHO THỬ • GIAO TRONG NGÀY" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Black"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Nút Bấm In -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Padding="14,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnCloseThermalModal_Click"/>
                        <Button x:Name="btnExecutePrint" Content="🖨️ XÁC NHẬN IN TEM (100x150MM)" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Click="BtnExecutePrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
