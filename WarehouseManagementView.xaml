<UserControl x:Class="Quanlykhohanglogicts.WarehouseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quanlykhohanglogicts"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1280"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Style Tab Button Pill -->
        <Style x:Key="TabNghiepVuKhoStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="khungTab" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungTab" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="khungTab" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Button Thao Tác -->
        <Style x:Key="NutThaoTacKhoStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="khungNut" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungNut" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="khungNut" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ KPI Thống Kê Kho -->
        <Style x:Key="TheKpiKhoStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel>

                <!-- ================= 1. HEADER TINH GỌN: HUB TRUNG CHUYỂN BƯU KIỆN ================= -->
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Trung Tâm Khai Thác &amp; Trung Chuyển Bưu Kiện (Hub Logistics)" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BƯU CỤC &amp; HUB TRUNG CHUYỂN" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tiếp nhận hàng về Hub • Phân luồng bưu kiện • Máng tuyến giao phát &amp; Xe tải trung chuyển liên tỉnh" 
                                   FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Nút làm mới dữ liệu -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnLamMoiKho" Style="{StaticResource NutThaoTacKhoStyle}" Height="36" Padding="14,0" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnLamMoiKho_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Làm Mới Dữ Liệu" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 2. THANH ĐIỀU HƯỚNG 6 NHÁNH LOGISTICS (KHÔNG BỊ TRÀN CUỘN) ================= -->
                <Border Background="White" CornerRadius="10" Padding="8,6" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="tabTongQuanKho" Style="{StaticResource TabNghiepVuKhoStyle}" Content="📊 1. Tổng Quan Sức Chứa" IsChecked="True" Checked="TabNghiepVu_Checked"/>
                        <RadioButton x:Name="tabTiepNhanHang" Style="{StaticResource TabNghiepVuKhoStyle}" Content="📥 2. Tiếp Nhận Vào Hub" Checked="TabNghiepVu_Checked"/>
                        <RadioButton x:Name="tabPhanLoaiHang" Style="{StaticResource TabNghiepVuKhoStyle}" Content="🏷️ 3. Phân Luồng Bưu Kiện" Checked="TabNghiepVu_Checked"/>
                        <RadioButton x:Name="tabViTriLuuTru" Style="{StaticResource TabNghiepVuKhoStyle}" Content="📍 4. Máng Tuyến &amp; Ô Kệ" Checked="TabNghiepVu_Checked"/>
                        <RadioButton x:Name="tabXuatHang" Style="{StaticResource TabNghiepVuKhoStyle}" Content="📤 5. Xuất Kho &amp; Bàn Giao" Checked="TabNghiepVu_Checked"/>
                        <RadioButton x:Name="tabLichSuNhapXuat" Style="{StaticResource TabNghiepVuKhoStyle}" Content="📜 6. Nhật Ký Biến Động Hub" Checked="TabNghiepVu_Checked"/>
                    </StackPanel>
                </Border>

                <!-- ================= 3. NỘI DUNG TỪNG NHÁNH CHỨC NĂNG ================= -->

                <!-- ========================================================================= -->
                <!-- NHÁNH 1: TỔNG QUAN HUB (OVERVIEW & CAPACITY) -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelTongQuanKho" Visibility="Visible">
                    <!-- Banner Cảnh Báo Quá Tải -->
                    <Border x:Name="brdCanhBaoSucChua" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCanhBaoSucChua" Text="Cảnh báo tải trọng kho bãi" FontWeight="SemiBold" Foreground="#B91C1C" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ KPI Thống Kê Vận Hành Hub -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: Tỷ lệ lấp đầy sàn kho -->
                        <Border Grid.Column="0" Style="{StaticResource TheKpiKhoStyle}">
                            <StackPanel>
                                <TextBlock Text="TỶ LỆ LẤP ĐẦY SÀN &amp; Ô KỆ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTyLeLapDayKho" Text="46.5%" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtTrangThaiTongThe" Text="Đang ở mức tải trọng an toàn" FontSize="11" Foreground="#059669"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: Bưu kiện đang lưu Hub chờ phân luồng/xuất phát -->
                        <Border Grid.Column="1" Style="{StaticResource TheKpiKhoStyle}">
                            <StackPanel>
                                <TextBlock Text="BƯU KIỆN ĐANG LƯU TẠI HUB" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTongBuuKienLuuHub" Text="102 bưu kiện" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                <TextBlock Text="Chờ phân luồng &amp; xuất phát" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 3: Tiếp nhận hôm nay -->
                        <Border Grid.Column="2" Style="{StaticResource TheKpiKhoStyle}">
                            <StackPanel>
                                <TextBlock Text="TIẾP NHẬN HÔM NAY" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTiepNhanHomNay" Text="4 lô hàng (766 kg)" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                                <TextBlock Text="Từ xe tải Linehaul &amp; Khách lẻ" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: Xuất kho hôm nay -->
                        <Border Grid.Column="3" Style="{StaticResource TheKpiKhoStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="ĐÃ XUẤT PHÁT HÔM NAY" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtXuatKhoHomNay" Text="12 chuyến đã xuất" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                                <TextBlock Text="Bàn giao Shipper &amp; Xe trung chuyển" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bố cục 2 cột: Sức chứa phân khu & Thao tác nhanh -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột trái: Tải trọng theo từng phân khu kho (Tự động tính toán động) -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="SỨC CHỨA &amp; TẢI TRỌNG THỜI GIAN THỰC TẠI CÁC PHÂN KHU" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <!-- Khu A: Tiêu chuẩn -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="🏢 Khu A: Khu Lưu Bưu Kiện Tiêu Chuẩn" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock x:Name="txtKhuAInfo" Text="1,250 kg / 2,000 kg (62.5%)" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Grid>
                                        <ProgressBar x:Name="pbKhuA" Height="8" Value="62.5" Maximum="100" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Khu EXP: Hỏa tốc -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="⚡ Khu EXP: Khu Bưu Kiện Hỏa Tốc &amp; Khẩn Cấp" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock x:Name="txtKhuEXPInfo" Text="120 kg / 500 kg (24.0%)" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#7C3AED"/>
                                        </Grid>
                                        <ProgressBar x:Name="pbKhuEXP" Height="8" Value="24" Maximum="100" Foreground="#7C3AED" Background="#E2E8F0" BorderThickness="0" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Khu Dock Inbound: Tiếp nhận hàng -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="📥 Sàn Dock Inbound: Khu Tiếp Nhận &amp; Chờ Phân Luồng" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock x:Name="txtKhuDockInfo" Text="950 kg / 2,000 kg (47.5%)" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                                        </Grid>
                                        <ProgressBar x:Name="pbKhuDock" Height="8" Value="47.5" Maximum="100" Foreground="#059669" Background="#E2E8F0" BorderThickness="0" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cột phải: Thao tác nhanh & Phím tắt quản lý kho -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="QUY TRÌNH THAO TÁC TẠI HUB LOGISTICS" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="42" Background="#EFF6FF" Foreground="#2563EB"
                                        Padding="12,0" Margin="0,0,0,8" Click="BtnChuyenSangTiepNhan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Bước 1: Tiếp Nhận Hàng Vào Hub (Xe Tải / Quầy)" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="42" Background="#F5F3FF" Foreground="#7C3AED"
                                        Padding="12,0" Margin="0,0,0,8" Click="BtnChuyenSangPhanLoai_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷️" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Bước 2: Phân Luồng (Giao Chặng Cuối vs Trung Chuyển)" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="42" Background="#FEF3C7" Foreground="#B45309"
                                        Padding="12,0" Margin="0,0,0,8" Click="BtnChuyenSangViTri_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📍" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Bước 3: Bản Đồ Máng Tuyến &amp; Ô Kệ Chờ Xuất" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="42" Background="#ECFDF5" Foreground="#059669"
                                        Padding="12,0" Margin="0,0,0,8" Click="BtnChuyenSangXuatHang_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📤" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Bước 4: Xác Nhận Xuất Kho &amp; Bàn Giao Vận Tải" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="42" Background="#F8FAFC" Foreground="#334155"
                                        BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,0" Click="BtnChuyenSangLichSu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📜" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Tra Cứu Nhật Ký Biến Động Hub" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- NHÁNH 2: TIẾP NHẬN & NHẬP KHO (INBOUND LOGISTICS HUB: XE TẢI & KHÁCH LẺ) -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelTiepNhanHang" Visibility="Collapsed">
                    <local:ImportManagementView x:Name="ucImportManagement"/>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- NHÁNH 3: PHÂN LUỒNG BƯU KIỆN TẠI DOCK (CHẶNG CUỐI VS TRUNG CHUYỂN) -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelPhanLoaiHang" Visibility="Collapsed">
                    <!-- Hộp giải thích nghiệp vụ phân loại 2 luồng -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Luồng 1: Hàng giao chặng cuối -->
                        <Border Grid.Column="0" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🛵" FontSize="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="HÀNG GIAO CHẶNG CUỐI (LAST-MILE)" FontSize="13" FontWeight="Bold" Foreground="#6D28D9"/>
                                </StackPanel>
                                <TextBlock Text="Bưu kiện phát cho khách nhận tại nội tỉnh/nội thành (Thái Nguyên: Sông Công, Phổ Yên, Đại Từ...). Sau khi phân loại sẽ xếp vào máng gom tuyến của Shipper để giao luôn trong ngày." 
                                           FontSize="12" Foreground="#5B21B6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Luồng 2: Hàng trung chuyển -->
                        <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🚛" FontSize="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="HÀNG TRUNG CHUYỂN LIÊN TỈNH (TRANSIT)" FontSize="13" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                                <TextBlock Text="Bưu kiện chuyển tiếp sang các Hub liên tỉnh (Hà Nội, Hải Phòng, Đà Nẵng, TP.HCM...). Sau khi phân loại sẽ xếp lên Pallet chuyển ra cửa xuất xe tải đường dài." 
                                           FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Danh sách bưu kiện cần phân luồng -->
                    <Border Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="DANH SÁCH BƯU KIỆN CHỜ PHÂN LOẠI TẠI DOCK" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="txtDemKienChoPhanLoai" Text="Đang tải dữ liệu bưu kiện chờ phân luồng..." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>

                                <!-- Tìm kiếm kiện hàng cần phân loại -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="36" Width="260" Margin="0,0,8,0">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                            <TextBox x:Name="txtTimKiemPhanLoai" Grid.Column="1" Margin="4,0" FontSize="12" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextChanged="TxtTimKiemPhanLoai_TextChanged"/>
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="36" Padding="12,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnLamMoiKho_Click">
                                        <TextBlock Text="Tải Lại"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="dgPhanLoaiHang" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      SelectionUnit="Cell" SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="False"
                                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowHeight="46">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D4ED8"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Bưu Kiện" Binding="{Binding OrderCode}" FontWeight="Bold" Width="130"/>
                                    <DataGridTextColumn Header="Mô Tả Hàng Hóa" Binding="{Binding ProductSummary}" Width="180"/>
                                    <DataGridTextColumn Header="Khối Lượng" Binding="{Binding Weight, StringFormat='{}{0:N1} kg'}" Width="95"/>
                                    <DataGridTextColumn Header="Bên Nhận / Địa Chỉ" Binding="{Binding ReceiverAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Khu Vực Đích" Binding="{Binding DestinationArea}" Width="140"/>
                                    
                                    <!-- Cột nút thao tác phân luồng -->
                                    <DataGridTemplateColumn Header="Thao Tác Phân Loại" Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="28" Padding="8,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1"
                                                            Click="BtnPhanLoaiChangCuoi_Click" ToolTip="Phân loại vào máng gom tuyến của Shipper nội tỉnh">
                                                        <TextBlock Text="🛵 Chặng Cuối"/>
                                                    </Button>
                                                    <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="28" Padding="8,0" FontSize="11"
                                                            Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                                            Click="BtnPhanLoaiTrungChuyen_Click" ToolTip="Phân loại vào Pallet xuất xe tải trung chuyển liên tỉnh">
                                                        <TextBlock Text="🚛 Trung Chuyển"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- NHÁNH 4: VỊ TRÍ MÁNG TUYẾN & Ô KỆ LƯU BÃI (SORTING LANES & RACKS) -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelViTriLuuTru" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="BẢN ĐỒ VỊ TRÍ MÁNG TUYẾN &amp; Ô KỆ LƯU BÃI TẠI HUB" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Theo dõi mức tải trọng thực tế (kg), công suất chứa của từng máng gom tuyến và ô kệ trung chuyển" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Nút Lọc Phân Khu & Nút Điều Chuyển -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Nút lọc phân khu -->
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="30" Padding="10,0" Background="#2563EB" Foreground="White" Tag="ALL" Click="BtnLocZone_Click">
                                                <TextBlock Text="Tất Cả"/>
                                            </Button>
                                            <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="30" Padding="10,0" Background="Transparent" Foreground="#64748B" Tag="A" Click="BtnLocZone_Click">
                                                <TextBlock Text="Khu A"/>
                                            </Button>
                                            <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="30" Padding="10,0" Background="Transparent" Foreground="#64748B" Tag="EXP" Click="BtnLocZone_Click">
                                                <TextBlock Text="Khu Hỏa Tốc"/>
                                            </Button>
                                            <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="30" Padding="10,0" Background="Transparent" Foreground="#64748B" Tag="IN" Click="BtnLocZone_Click">
                                                <TextBlock Text="Dock Inbound"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Nút Mở Form Điều Chuyển Ô Kệ -->
                                    <Button x:Name="btnMoDieuChuyenKe" Style="{StaticResource NutThaoTacKhoStyle}" Height="36" Padding="14,0" 
                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" Click="BtnMoDieuChuyenKe_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Điều Chuyển Máng/Kệ" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="icViTriLuuTru">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="280">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📍" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding LocationCode}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    </StackPanel>
                                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="6,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusDisplayName}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Zone}" FontSize="11.5" Foreground="#64748B"/>
                                                <Grid Margin="0,8,0,4">
                                                    <TextBlock Text="Tải trọng thực tế:" FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding CurrentWeight, StringFormat='{}{0:N0} kg'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Sức tải tối đa:" FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding MaxWeightCapacity, StringFormat='{}{0:N0} kg'}" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                                                </Grid>

                                                <!-- Thanh tỷ lệ lấp đầy theo màu trạng thái -->
                                                <ProgressBar Height="8" Value="{Binding OccupancyPercentage, Mode=OneWay}" Maximum="100" Foreground="{Binding StatusColor}" Background="#E2E8F0" BorderThickness="0"/>
                                                <TextBlock Text="{Binding OccupancyPercentage, StringFormat='Tỷ lệ lấp đầy: {0}%'}" FontSize="10.5" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- NHÁNH 5: XUẤT KHO & BÀN GIAO VẬN TẢI (OUTBOUND LOGISTICS HUB) -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelXuatHang" Visibility="Collapsed">
                    <local:ExportManagementView x:Name="ucExportManagement"/>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- NHÁNH 6: LỊCH SỬ BIẾN ĐỘNG HUB & AUDIT TRAIL LOG -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelLichSuNhapXuat" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="NHẬT KÝ BIẾN ĐỘNG BƯU KIỆN TẠI HUB TOÀN DIỆN (AUDIT LOG)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Ghi nhận vết kiểm toán: Tiếp nhận hàng về, phân luồng chặng cuối / trung chuyển, điều chuyển và xuất kho" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Bộ lọc đa chiều & Xuất CSV -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- ComboBox lọc loại biến động -->
                                    <ComboBox x:Name="cboLocLoaiBienDong" Width="170" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center" SelectionChanged="CboLocLoaiBienDong_SelectionChanged">
                                        <ComboBoxItem Content="Tất Cả Nghiệp Vụ" IsSelected="True"/>
                                        <ComboBoxItem Content="📥 Tiếp Nhận Hàng"/>
                                        <ComboBoxItem Content="🏷️ Phân Loại Chặng Cuối"/>
                                        <ComboBoxItem Content="🚛 Phân Loại Trung Chuyển"/>
                                        <ComboBoxItem Content="📤 Xuất Hàng Chặng Cuối"/>
                                        <ComboBoxItem Content="🚚 Xuất Hàng Trung Chuyển"/>
                                        <ComboBoxItem Content="🔄 Điều Chuyển Máng/Kệ"/>
                                    </ComboBox>

                                    <!-- Ô tìm kiếm nhật ký -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="36" Width="200" Margin="0,0,8,0">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                            <TextBox x:Name="txtTimKiemLichSu" Grid.Column="1" Margin="4,0" FontSize="12" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextChanged="TxtTimKiemLichSu_TextChanged"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nút xuất báo cáo nhật ký ra CSV -->
                                    <Button x:Name="btnXuatLichSuCsv" Style="{StaticResource NutThaoTacKhoStyle}" Height="36" Padding="14,0" 
                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#047857" Click="BtnXuatLichSuCsv_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="Xuất CSV" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Bảng DataGrid Nhật Ký Biến Động Kho -->
                            <DataGrid x:Name="dgLichSuBienDongKho" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      SelectionUnit="Cell" SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="False"
                                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowHeight="44">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1D4ED8"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Giao Dịch" Binding="{Binding TransactionCode}" FontWeight="Bold" Width="130"/>
                                    <DataGridTextColumn Header="Thời Gian Ghi Nhận" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" FontWeight="SemiBold" Foreground="#0F172A" Width="165"/>
                                    
                                    <DataGridTemplateColumn Header="Loại Biến Động" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Background="#F1F5F9">
                                                    <TextBlock Text="{Binding MovementTypeDisplayName}" Foreground="{Binding MovementTypeColor}" FontWeight="Bold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Bưu Kiện / Hàng Hóa" Binding="{Binding ItemName}" Width="200"/>
                                    <DataGridTextColumn Header="Khối Lượng" Binding="{Binding Weight, StringFormat='{}{0:N1} kg'}" Width="95"/>
                                    <DataGridTextColumn Header="Luồng Di Chuyển" Binding="{Binding SourceOrDestination}" Width="*"/>
                                    <DataGridTextColumn Header="Vị Trí Máng/Kệ" Binding="{Binding LocationCode}" Width="130"/>
                                    <DataGridTextColumn Header="Người Thực Hiện" Binding="{Binding OperatorName}" Width="140"/>
                                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- 4. POPUP OVERLAY: ĐIỀU CHUYỂN HÀNG GIỮA CÁC MÁNG TUYẾN / Ô KỆ ================= -->
        <!-- ========================================================================= -->
        <Grid x:Name="modalDieuChuyenKe" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="14" Width="620" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <!-- Tiêu đề modal -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lệnh Điều Chuyển Hàng Giữa Máng Tuyến &amp; Ô Kệ" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <TextBlock Text="Di dời bưu kiện/hàng hóa từ vị trí máng nguồn sang vị trí máng đích (Relocation)" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource NutThaoTacKhoStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Width="30" Height="30" Background="#F1F5F9" Foreground="#64748B" Content="✕" FontWeight="Bold" FontSize="13" Click="BtnDongDieuChuyen_Click"/>
                    </Grid>

                    <!-- 2 cột: Vị trí nguồn và Vị trí đích -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vị trí nguồn -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="VỊ TRÍ NGUỒN (XUẤT ĐI) (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboViTriNguon" Height="38" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Vị trí đích -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="VỊ TRÍ ĐÍCH (CHUYỂN ĐẾN) (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboViTriDich" Height="38" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Khối lượng & Mô tả hàng -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="KHỐI LƯỢNG (KG) (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtKhoiLuongDieuChuyen" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" FontWeight="Bold" Text="50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="MÔ TẢ BƯU KIỆN / LÔ HÀNG (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMoTaHangDieuChuyen" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" Text="Di dời kiện hàng chờ ca phát"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ghi chú điều chuyển -->
                    <TextBlock Text="GHI CHÚ ĐIỀU CHUYỂN" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtGhiChuDieuChuyen" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="12" Margin="0,0,0,16"/>

                    <!-- Nút bấm xác nhận -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource NutThaoTacKhoStyle}" Height="38" Padding="16,0" Background="#F1F5F9" Foreground="#475569" Margin="0,0,8,0" Click="BtnDongDieuChuyen_Click">
                            <TextBlock Text="Hủy Bỏ" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="btnXacNhanDieuChuyen" Style="{StaticResource NutThaoTacKhoStyle}" Height="38" Padding="20,0" Background="#059669" Foreground="White" Click="BtnXacNhanDieuChuyen_Click">
                            <TextBlock Text="Xác Nhận Điều Chuyển" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
