<UserControl x:Class="Quanlykhohanglogicts.PriorityDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quanlykhohanglogicts"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Style Button Thao Tác Chuẩn -->
        <Style x:Key="NutThaoTacStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="khungVien" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Thẻ KPI -->
        <Style x:Key="TheKpiStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel>

                <!-- ================= HEADER: TIÊU ĐỀ & KỊCH BẢN THỰC THI ================= -->
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Điều Phối &amp; Phân Bổ Đơn Hàng Theo Năng Lực" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="THUẬT TOÁN ƯU TIÊN HỎA TỐC &amp; SLA" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tự động lọc đơn khi kho quá tải: 100% Đơn Hỏa Tốc (Express) đi trước • Đơn cận hạn cam kết SLA bổ sung cho đủ hạn mức • Đơn an toàn lưu kho ca sau" 
                                   FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Nút công cụ nhanh -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- KỊCH BẢN THÁI NGUYÊN (DEMO 100 ĐƠN GIAO 40 ĐƠN) -->
                        <Button x:Name="btnSinh100DonThaiNguyen" Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="14,0" 
                                Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Foreground="#0F766E" Margin="0,0,10,0" Click="BtnSinh100DonThaiNguyen_Click"
                                ToolTip="Khởi tạo kịch bản 100 đơn tại Thái Nguyên và tự động chạy phân bổ ưu tiên 40 đơn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏞️" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="100 Đơn Thái Nguyên (Giao 40)" FontWeight="Bold" FontSize="12.5"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSinh100DonMau" Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="14,0" 
                                Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Foreground="#4338CA" Margin="0,0,10,0" Click="BtnSinh100DonMau_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎲" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="Sinh 100 Đơn Kịch Bản Chung" FontSize="12.5"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLamMoiDuLieu" Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="12,0" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnLamMoiDuLieu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Nạp Lại Kho" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= BẢNG ĐIỀU KHIỂN NĂNG LỰC & HẠN MỨC GIAO HÔM NAY ================= -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột 1: Cài đặt hạn mức giao hôm nay -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Năng Lực Giao Hôm Nay:" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="4,2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="txtNangLucGiaoToiDa" Text="40" Width="55" FontSize="15" FontWeight="Bold" 
                                             Foreground="#2563EB" BorderThickness="0" Background="Transparent" 
                                             TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="đơn" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Preset nút bấm nhanh: Thêm preset 40 -->
                            <TextBlock Text="Chọn nhanh:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="btnPreset30" Content="30" Style="{StaticResource NutThaoTacStyle}" Height="28" Width="36" Background="#F1F5F9" Foreground="#475569" Margin="0,0,4,0" FontSize="11" Click="BtnPreset_Click"/>
                            <Button x:Name="btnPreset40" Content="40" Style="{StaticResource NutThaoTacStyle}" Height="28" Width="36" Background="#EFF6FF" Foreground="#2563EB" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Click="BtnPreset_Click"/>
                            <Button x:Name="btnPreset50" Content="50" Style="{StaticResource NutThaoTacStyle}" Height="28" Width="36" Background="#F1F5F9" Foreground="#475569" Margin="0,0,4,0" FontSize="11" Click="BtnPreset_Click"/>
                            <Button x:Name="btnPreset70" Content="70" Style="{StaticResource NutThaoTacStyle}" Height="28" Width="36" Background="#F1F5F9" Foreground="#475569" Margin="0,0,4,0" FontSize="11" Click="BtnPreset_Click"/>
                            <Button x:Name="btnPreset100" Content="100" Style="{StaticResource NutThaoTacStyle}" Height="28" Width="40" Background="#F1F5F9" Foreground="#475569" Margin="0,0,10,0" FontSize="11" Click="BtnPreset_Click"/>

                            <Button x:Name="btnLayQuotaShipper" Style="{StaticResource NutThaoTacStyle}" Height="28" Padding="8,0" Background="#F0FDF4" Foreground="#166534" FontSize="11" Margin="0,0,12,0" Click="BtnLayQuotaShipper_Click">
                                <TextBlock Text="🛵 Quota Shipper"/>
                            </Button>

                            <!-- Bộ Lọc Khu Vực Tỉnh Thành (Thái Nguyên, Hà Nội...) -->
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="6,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📍 Khu Vực:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cboLocKhuVuc" Width="145" Height="26" BorderThickness="0" Background="Transparent" 
                                              SelectionChanged="CboLocKhuVuc_SelectionChanged">
                                        <ComboBoxItem Content="-- Tất Cả Khu Vực --" IsSelected="True"/>
                                        <ComboBoxItem Content="Thái Nguyên"/>
                                        <ComboBoxItem Content="Hà Nội"/>
                                        <ComboBoxItem Content="Cầu Giấy"/>
                                        <ComboBoxItem Content="Hà Đông"/>
                                        <ComboBoxItem Content="Ba Đình"/>
                                        <ComboBoxItem Content="Đống Đa"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Cột 3: Nút chạy thuật toán ưu tiên nổi bật -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnChayThuatToanPhanBo" Style="{StaticResource NutThaoTacStyle}" Height="42" Padding="20,0" 
                                    Background="#2563EB" Foreground="White" FontSize="13.5" FontWeight="Bold" Click="BtnChayThuatToanPhanBo_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" Margin="0,0,8,0" FontSize="15"/>
                                    <TextBlock Text="CHẠY THUẬT TOÁN PHÂN BỔ ƯU TIÊN"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 4 THẺ KPI TOÀN CỤC ================= -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Tổng đơn chờ xử lý -->
                    <Border Grid.Column="0" Style="{StaticResource TheKpiStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <TextBlock Text="TỔNG ĐƠN TRONG KHO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="txtTongDonChoPhanBo" Text="0 đơn" FontSize="23" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                            <TextBlock Text="Chờ điều phối xuất bến" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Đơn Hỏa Tốc Express (100% duyệt) -->
                    <Border Grid.Column="1" Style="{StaticResource TheKpiStyle}" BorderBrush="#DDD6FE" Background="#FDF4FF">
                        <StackPanel>
                            <TextBlock Text="ĐƠN HỎA TỐC ⚡ EXPRESS" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                            <TextBlock x:Name="txtDonHoaTocExpress" Text="0 đơn" FontSize="23" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtTyLeDuyetHoaToc" Text="Cam kết duyệt 100%" FontSize="11" Foreground="#9333EA" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Được duyệt giao ngay hôm nay -->
                    <Border Grid.Column="2" Style="{StaticResource TheKpiStyle}" BorderBrush="#A7F3D0" Background="#F0FDF4">
                        <StackPanel>
                            <TextBlock Text="🟢 ĐƯỢC DUYỆT GIAO NGAY" FontSize="11" FontWeight="SemiBold" Foreground="#059669"/>
                            <TextBlock x:Name="txtDonDuocDuyet" Text="0 / 50 đơn" FontSize="23" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            <TextBlock Text="Ưu tiên Cấp 1 + Cấp 2 SLA" FontSize="11" Foreground="#047857"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Lưu kho chờ ca sau -->
                    <Border Grid.Column="3" Style="{StaticResource TheKpiStyle}" BorderBrush="#FED7AA" Background="#FFFBEB">
                        <StackPanel>
                            <TextBlock Text="🟡 LƯU KHO CA SAU" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                            <TextBlock x:Name="txtDonLuuKhoCaSau" Text="0 đơn" FontSize="23" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            <TextBlock Text="Đơn tiêu chuẩn SLA còn xa" FontSize="11" Foreground="#B45309"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- THANH TIẾN ĐỘ CÔNG SUẤT -->
                <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock x:Name="txtCongSuatHienThi" Text="Tỷ lệ lấp đầy hạn mức: 50 / 50 đơn (100% công suất vận chuyển ngày)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="txtGiaiThichThuatToan" Text="Ma trận: Điểm Hỏa tốc (+1000) > SLA Quá hạn (+500) > Cận hạn (+300) > FIFO (+50)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar Grid.Row="1" x:Name="pbCongSuatGiao" Height="10" Maximum="100" Value="100" Foreground="#2563EB" Background="#F1F5F9" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- ================= BỐ CỤC 2 PHÂN HỆ TAB: DUYỆT GIAO vs LƯU KHO ================= -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="tabNhomDuyetGiao" Content="🟢 DANH SÁCH DUYỆT GIAO NGAY" 
                                     IsChecked="True" Style="{x:Null}" FontWeight="Bold" FontSize="13" 
                                     Foreground="#059669" Margin="0,0,20,0" Checked="TabPhanBo_Checked" Cursor="Hand"/>

                        <RadioButton x:Name="tabNhomLuuKho" Content="🟡 DANH SÁCH LƯU KHO CHỜ CA SAU" 
                                     IsChecked="False" Style="{x:Null}" FontWeight="Bold" FontSize="13" 
                                     Foreground="#D97706" Checked="TabPhanBo_Checked" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Thao tác xuất báo cáo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnXuatBaoCaoCsv" Style="{StaticResource NutThaoTacStyle}" Height="34" Padding="12,0" 
                                Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" Margin="0,0,10,0" Click="BtnXuatBaoCaoCsv_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,6,0"/>
                                <TextBlock Text="Xuất Báo Cáo Phân Bổ (CSV)"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPheDuyetXuatKhoHangLoat" Style="{StaticResource NutThaoTacStyle}" Height="34" Padding="14,0" 
                                Background="#059669" Foreground="White" FontWeight="Bold" Click="BtnPheDuyetXuatKhoHangLoat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,6,0"/>
                                <TextBlock Text="Phê Duyệt Xuất Kho &amp; Gán Shipper"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= BẢNG 1: DANH SÁCH ĐƯỢC DUYỆT GIAO NGAY ================= -->
                <Border x:Name="panelDuyetGiao" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Danh sách các đơn hàng được ưu tiên giao ngay hôm nay (Xếp theo điểm số ma trận SLA &amp; Hỏa tốc)" FontSize="12.5" Foreground="#64748B"/>
                            <TextBlock x:Name="txtSoLuongDuyetHienTai" Text="50 đơn" FontSize="12" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="dgDonDuyetGiao" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="44"
                                  Background="White" RowHeaderWidth="0" MinHeight="350" MaxHeight="520"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hạng" Binding="{Binding Rank}" FontWeight="Bold" Width="55"/>
                                
                                <DataGridTemplateColumn Header="Mã Đơn &amp; Loại Dịch Vụ" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OrderCode}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <Border Background="{Binding PriorityBadgeBackground}" CornerRadius="4" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ServiceTypeTag}" Foreground="{Binding PriorityBadgeColor}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cấp Độ Ưu Tiên" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Background="{Binding PriorityBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding PriorityLevel}" Foreground="{Binding PriorityBadgeColor}" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding PriorityScore, StringFormat='Điểm ma trận: {0:N0} đ'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Hạn SLA &amp; Thời Gian Còn Lại" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SlaRemainingText}" Foreground="{Binding SlaTextColor}" FontWeight="Bold" FontSize="11.5"/>
                                                <TextBlock Text="{Binding EstimatedDeliveryDate, StringFormat='Hạn: HH:mm - dd/MM'}" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Khu Vực Giao" Binding="{Binding DestinationArea}" FontWeight="SemiBold" Width="110"/>
                                <DataGridTextColumn Header="Người Nhận" Binding="{Binding ReceiverName}" Width="130"/>
                                <DataGridTextColumn Header="SĐT" Binding="{Binding ReceiverPhone}" Width="105"/>
                                <DataGridTextColumn Header="Tiền Thu COD" Binding="{Binding CodAmount, StringFormat={}{0:N0} đ}" Width="110"/>

                                <!-- Cột thao tác điều chuyển thủ công -->
                                <DataGridTemplateColumn Header="Thao Tác" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NutThaoTacStyle}" Background="#FEF2F2" Foreground="#DC2626"
                                                    Padding="8,4" FontSize="11" Click="BtnHoanDonSangCaSau_Click" ToolTip="Hoãn đơn này sang nhóm lưu kho">
                                                <TextBlock Text="⬇️ Hoãn Lại"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ================= BẢNG 2: DANH SÁCH LƯU KHO CHỜ CA SAU ================= -->
                <Border x:Name="panelLuuKho" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Các đơn hàng tiêu chuẩn được giữ lại lưu kho an toàn do vượt quá hạn mức năng lực ngày (SLA còn an toàn, dời ca sau)" FontSize="12.5" Foreground="#64748B"/>
                            <TextBlock x:Name="txtSoLuongLuuKhoHienTai" Text="50 đơn" FontSize="12" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                        </Grid>

                        <DataGrid x:Name="dgDonLuuKho" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="44"
                                  Background="White" RowHeaderWidth="0" MinHeight="350" MaxHeight="520"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" FontWeight="Bold" Width="140"/>
                                <DataGridTextColumn Header="Hàng Hóa" Binding="{Binding ProductSummary}" Width="180"/>
                                
                                <DataGridTemplateColumn Header="Tình Trạng SLA Còn Lại" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SlaRemainingText}" Foreground="{Binding SlaTextColor}" FontWeight="Bold" FontSize="11.5"/>
                                                <TextBlock Text="{Binding EstimatedDeliveryDate, StringFormat='Hạn: HH:mm - dd/MM'}" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Lý Do Lưu Kho / Hoãn Ca" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding AllocationReason}" Foreground="#92400E" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Khu Vực Giao" Binding="{Binding DestinationArea}" FontWeight="SemiBold" Width="110"/>
                                <DataGridTextColumn Header="Người Nhận" Binding="{Binding ReceiverName}" Width="130"/>
                                <DataGridTextColumn Header="Tiền Thu COD" Binding="{Binding CodAmount, StringFormat={}{0:N0} đ}" Width="110"/>

                                <!-- Nút đẩy lên ưu tiên gấp nếu khách giục -->
                                <DataGridTemplateColumn Header="Thao Tác" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NutThaoTacStyle}" Background="#ECFDF5" Foreground="#059669"
                                                    Padding="8,4" FontSize="11" Click="BtnDayLenDuyetGiao_Click" ToolTip="Đưa đơn này lên nhóm duyệt giao gấp">
                                                <TextBlock Text="⬆️ Đẩy Lên Duyệt"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
