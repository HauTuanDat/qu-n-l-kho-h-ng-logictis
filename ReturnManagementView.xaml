<UserControl x:Class="Quanlykhohanglogicts.ReturnManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quanlykhohanglogicts"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1250"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Style Button Thao Tác Chuẩn -->
        <Style x:Key="NutThaoTacStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="khungVien" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="khungVien" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ KPI Thống Kê -->
        <Style x:Key="TheKpiStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- RadioButton Tab Điều Hướng Phụ 6 Nhánh -->
        <Style x:Key="TabDieuHuongStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="khungTab" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="khungTab" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="khungTab" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
            <StackPanel>

                <!-- ================= HEADER: TIÊU ĐỀ & MÔ TẢ ================= -->
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Quản Lý Hàng Hoàn &amp; Giao Thất Bại (Reverse Logistics &amp; RTO)" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#FEE2E2" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LOGISTICS NGƯỢC • 6 NHÁNH" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Kiểm soát vòng đời hàng đổi trả: Giao thất bại ➔ Ghi nhận lý do ➔ Hẹn phát lại (Tối đa 3 lần) ➔ Duyệt chuyển hoàn RTO ➔ Lưu kho hoàn ➔ Trả lại Shop" 
                                   FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Nút thao tác nhanh -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnSinhDuLieuMauRto" Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="14,0" 
                                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" Foreground="#C2410C" Margin="0,0,10,0" Click="BtnSinhDuLieuMauRto_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎲" Margin="0,0,6,0"/>
                                <TextBlock Text="Sinh Dữ Liệu Hàng Hoàn Mẫu" FontWeight="SemiBold" FontSize="12.5"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLamMoiDuLieu" Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="12,0" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnLamMoiDuLieu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="Làm Mới"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= THANH ĐIỀU HƯỚNG PHỤ (6 NHÁNH THEO YÊU CẦU) ================= -->
                <Border Background="White" CornerRadius="12" Padding="8,6" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="tabDonThatBai" Style="{StaticResource TabDieuHuongStyle}" IsChecked="True" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚨" Margin="0,0,6,0"/>
                                <TextBlock Text="Đơn Giao Thất Bại Trong Ngày"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabPhanLoaiLyDo" Style="{StaticResource TabDieuHuongStyle}" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,6,0"/>
                                <TextBlock Text="Phân Loại Lý Do Giao Hỏng"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabLenLichPhatLai" Style="{StaticResource TabDieuHuongStyle}" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️" Margin="0,0,6,0"/>
                                <TextBlock Text="Lên Lịch Phát Lại Lần 2 / 3"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabDuyetChuyenHoan" Style="{StaticResource TabDieuHuongStyle}" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                <TextBlock Text="Duyệt Chuyển Hoàn (RTO)"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabKhoLuuHangHoan" Style="{StaticResource TabDieuHuongStyle}" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,6,0"/>
                                <TextBlock Text="Khu Vực Kho Lưu Hàng Hoàn"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabBienBanTraShop" Style="{StaticResource TabDieuHuongStyle}" Checked="TabDieuHuong_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,6,0"/>
                                <TextBlock Text="Biên Bản Bàn Giao Trả Shop"/>
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </Border>

                <!-- ================= NHÁNH 1: ĐƠN GIAO THẤT BẠI TRONG NGÀY ================= -->
                <StackPanel x:Name="panelDonThatBai">
                    <!-- 4 Thẻ KPI Đơn Thất Bại -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TheKpiStyle}" BorderBrush="#FCA5A5" Background="#FEF2F2">
                            <StackPanel>
                                <TextBlock Text="ĐƠN GIAO THẤT BẠI HÔM NAY" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                <TextBlock x:Name="txtTongDonThatBai" Text="0 đơn" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                <TextBlock Text="Cần xử lý tái phát hoặc hoàn" FontSize="11" Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource TheKpiStyle}" BorderBrush="#FED7AA" Background="#FFFBEB">
                            <StackPanel>
                                <TextBlock Text="CHỜ HẸN PHÁT LẠI (LẦN 1 &amp; 2)" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                                <TextBlock x:Name="txtChoPhatLai" Text="0 đơn" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                                <TextBlock Text="Khách hẹn giờ hoặc bận máy" FontSize="11" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource TheKpiStyle}" BorderBrush="#DDD6FE" Background="#FDF4FF">
                            <StackPanel>
                                <TextBlock Text="ĐỦ ĐIỀU KIỆN CHUYỂN HOÀN (RTO)" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                <TextBlock x:Name="txtDuDieuKienHoan" Text="0 đơn" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                <TextBlock Text="Hỏng 3 lần hoặc Boom hàng" FontSize="11" Foreground="#9333EA"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource TheKpiStyle}" BorderBrush="#CBD5E1">
                            <StackPanel>
                                <TextBlock Text="TỔNG TIỀN COD ĐANG BỊ KẸT" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBlock x:Name="txtTongTienCodKet" Text="0 đ" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                <TextBlock Text="Chưa thể thu hồi đối soát" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bộ lọc & Tìm kiếm -->
                    <Border Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtTimKiemDonThatBai" Height="36" Margin="0,0,12,0" Padding="8,0"
                                     VerticalContentAlignment="Center" FontSize="12.5" BorderBrush="#CBD5E1"
                                     Tag="Tìm mã vận đơn, người nhận, lý do hỏng..." TextChanged="TxtTimKiemDonThatBai_TextChanged"/>

                            <ComboBox x:Name="cbLocSoLanThatBai" Grid.Column="1" Height="36" Margin="0,0,12,0"
                                      VerticalContentAlignment="Center" FontSize="12.5" SelectionChanged="CbLocSoLanThatBai_SelectionChanged">
                                <ComboBoxItem Content="-- Tất Cả Số Lần Hỏng --" IsSelected="True"/>
                                <ComboBoxItem Content="Hỏng lần 1 (Mới phát không được)"/>
                                <ComboBoxItem Content="Hỏng lần 2 (Đã phát lại 1 lần)"/>
                                <ComboBoxItem Content="Hỏng lần 3 (Bắt buộc chuyển hoàn)"/>
                            </ComboBox>

                            <Button Grid.Column="2" Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="16,0"
                                    Background="#4F46E5" Foreground="White" Click="BtnChuyenSangLenLich_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱️" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lên Lịch Phát Lại Hàng Loạt"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- DataGrid Đơn Giao Thất Bại -->
                    <DataGrid x:Name="dgDonThatBai" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="46"
                              Background="White" RowHeaderWidth="0" MinHeight="360" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" FontWeight="Bold" Width="130"/>
                            
                            <DataGridTemplateColumn Header="Số Lần Thất Bại" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                Background="{Binding FailedDeliveryCount, Converter={x:Static local:ReturnManagementView.LanThatBaiToBgConverter}}">
                                            <TextBlock Text="{Binding FailedDeliveryCount, StringFormat='🚨 Lần {0} / 3'}" 
                                                       Foreground="{Binding FailedDeliveryCount, Converter={x:Static local:ReturnManagementView.LanThatBaiToFgConverter}}" 
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Lý Do Không Giao Được" Binding="{Binding FailureReason}" FontWeight="SemiBold" Width="220"/>
                            <DataGridTextColumn Header="Tài Xế Báo Hỏng" Binding="{Binding AssignedShipperName}" Width="140"/>
                            <DataGridTextColumn Header="Người Nhận" Binding="{Binding ReceiverName}" Width="130"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding ReceiverPhone}" Width="105"/>
                            <DataGridTextColumn Header="Khu Vực Giao" Binding="{Binding DestinationArea}" Width="120"/>
                            <DataGridTextColumn Header="Tiền COD" Binding="{Binding CodAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" Width="110"/>

                            <!-- Cột Thao Tác Trực Tiếp -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource NutThaoTacStyle}" Height="28" Padding="8,0" Background="#FEF3C7" Foreground="#B45309" Margin="0,0,6,0" Click="BtnMoModalPhatLai_Click" ToolTip="Hẹn lịch phát lại lần kế tiếp">
                                                <TextBlock Text="⏱️ Hẹn Lại"/>
                                            </Button>
                                            <Button Style="{StaticResource NutThaoTacStyle}" Height="28" Padding="8,0" Background="#FEE2E2" Foreground="#DC2626" Click="BtnMoModalDuyetHoan_Click" ToolTip="Duyệt chuyển hoàn về Shop">
                                                <TextBlock Text="🔄 Duyệt Hoàn"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- ================= NHÁNH 2: PHÂN LOẠI LÝ DO GIAO HỎNG ================= -->
                <StackPanel x:Name="panelPhanLoaiLyDo" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bảng Tỷ Lệ Các Lý Do Phổ Biến -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BẢNG PHÂN LOẠI &amp; TỶ LỆ NGUYÊN NHÂN GIAO THẤT BẠI" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                <!-- Lý do 1 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="1. Khách không nghe máy / Thuê bao (Gọi 3 cuộc)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock Text="38% (42 đơn)" FontSize="12" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Value="38" Foreground="#DC2626" Background="#F1F5F9" BorderThickness="0"/>
                                </Grid>

                                <!-- Lý do 2 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="2. Khách hẹn lại sau giờ hành chính / ngày khác" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock Text="27% (30 đơn)" FontSize="12" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Value="27" Foreground="#EA580C" Background="#F1F5F9" BorderThickness="0"/>
                                </Grid>

                                <!-- Lý do 3 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="3. Sai địa chỉ / Không tìm thấy số nhà (Đã chuyển trọ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock Text="15% (17 đơn)" FontSize="12" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Value="15" Foreground="#D97706" Background="#F1F5F9" BorderThickness="0"/>
                                </Grid>

                                <!-- Lý do 4 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="4. Khách từ chối nhận (Boom hàng / Không đúng mẫu)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock Text="12% (13 đơn)" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Value="12" Foreground="#7C3AED" Background="#F1F5F9" BorderThickness="0"/>
                                </Grid>

                                <!-- Lý do 5 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="5. Hàng bị móp méo / Hỏng hóc bao bì đóng gói" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock Text="8% (9 đơn)" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="8" Value="8" Foreground="#64748B" Background="#F1F5F9" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hướng Dẫn & Quy Định Xử Lý Bưu Cục -->
                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="10" Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="QUY ĐỊNH XỬ LÝ GIAO HỎNG (SOP)" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <TextBlock Text="• Thất bại lần 1: Bắt buộc gọi tối thiểu 3 cuộc điện thoại cách nhau 15 phút. Lưu kho bưu cục hẹn phát lại ngày hôm sau." TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>
                                <TextBlock Text="• Thất bại lần 2: CSKH bưu cục chủ động nhắn tin Zalo / SMS cho người nhận để xác nhận lại thời gian thuận tiện." TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>
                                <TextBlock Text="• Thất bại lần 3: Tự động khóa đơn, chuyển sang trạng thái Đủ điều kiện chuyển hoàn RTO và thông báo cho Shop gửi." TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>
                                <TextBlock Text="• Boom hàng dứt khoát: Nếu khách khẳng định không mua hoặc từ chối dứt khoát, duyệt chuyển hoàn ngay mà không cần đợi đủ 3 lần." TextWrapping="Wrap" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ================= NHÁNH 3: LÊN LỊCH PHÁT LẠI LẦN 2 / 3 ================= -->
                <StackPanel x:Name="panelLenLichPhatLai" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách các bưu kiện giao hỏng lần 1 &amp; lần 2 cần tái phân công vào các ca giao kế tiếp" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource NutThaoTacStyle}" Height="34" Padding="14,0" Background="#2563EB" Foreground="White" Click="BtnChuyenSangDieuPhoiGiaoHang_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚚" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chuyển Sang Điều Phối Giao Hàng (Mục 5)"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgDonPhatLai" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="44"
                              Background="White" RowHeaderWidth="0" MinHeight="360" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" FontWeight="Bold" Width="130"/>
                            <DataGridTextColumn Header="Hẹn Phát Lại Lúc" Binding="{Binding EstimatedDeliveryDate, StringFormat='HH:mm - dd/MM/yyyy'}" FontWeight="Bold" Foreground="#2563EB" Width="160"/>
                            <DataGridTextColumn Header="Số Lần Đã Phát" Binding="{Binding FailedDeliveryCount, StringFormat='Đã hỏng {0} lần'}" Width="120"/>
                            <DataGridTextColumn Header="Ghi Chú Hẹn Khách" Binding="{Binding Notes}" Width="240"/>
                            <DataGridTextColumn Header="Người Nhận" Binding="{Binding ReceiverName}" Width="130"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding ReceiverPhone}" Width="105"/>
                            <DataGridTextColumn Header="Khu Vực Giao" Binding="{Binding DestinationArea}" Width="120"/>
                            <DataGridTextColumn Header="Tiền COD" Binding="{Binding CodAmount, StringFormat={}{0:N0} đ}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- ================= NHÁNH 4: DUYỆT CHUYỂN HOÀN (RTO) ================= -->
                <StackPanel x:Name="panelDuyetChuyenHoan" Visibility="Collapsed">
                    <Border Background="#FEE2E2" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#FECACA" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DANH SÁCH BƯU KIỆN ĐỦ ĐIỀU KIỆN CHUYỂN HOÀN VỀ SHOP" FontSize="13.5" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="Bưu kiện đã thất bại 3 lần hoặc khách từ chối nhận. Bấm duyệt chuyển hoàn để cấp mã RTO và chuyển vào kho hoàn." FontSize="11.5" Foreground="#B91C1C"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgDonDuDieuKienHoan" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="44"
                              Background="White" RowHeaderWidth="0" MinHeight="360" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" FontWeight="Bold" Width="130"/>
                            <DataGridTextColumn Header="Số Lần Hỏng" Binding="{Binding FailedDeliveryCount, StringFormat='🚨 Hỏng {0} lần'}" FontWeight="Bold" Foreground="#DC2626" Width="120"/>
                            <DataGridTextColumn Header="Lý Do Cuối Cùng" Binding="{Binding FailureReason}" Width="230"/>
                            <DataGridTextColumn Header="Bên Gửi (Shop)" Binding="{Binding SenderName}" FontWeight="SemiBold" Width="160"/>
                            <DataGridTextColumn Header="Người Nhận" Binding="{Binding ReceiverName}" Width="130"/>
                            <DataGridTextColumn Header="Tiền COD" Binding="{Binding CodAmount, StringFormat={}{0:N0} đ}" Width="110"/>

                            <DataGridTemplateColumn Header="Thao Tác" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NutThaoTacStyle}" Height="30" Padding="12,0" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="BtnMoModalDuyetHoan_Click">
                                            <TextBlock Text="🔄 Duyệt Hoàn"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- ================= NHÁNH 5: KHU VỰC KHO LƯU HÀNG HOÀN ================= -->
                <StackPanel x:Name="panelKhoLuuHangHoan" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Các bưu kiện đã được duyệt chuyển hoàn và đang lưu giữ tại Kệ RTO để chờ trả về nơi gửi" FontSize="13" Foreground="#64748B"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="16,0" Background="#059669" Foreground="White" Click="BtnMoModalLapBienBanTraShop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lập Biên Bản Bàn Giao Trả Shop"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgHangLuuKhoHoan" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="44"
                              Background="White" RowHeaderWidth="0" MinHeight="360" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã RTO Chuyển Hoàn" Binding="{Binding RtoTrackingCode}" FontWeight="Bold" Foreground="#7C3AED" Width="150"/>
                            <DataGridTextColumn Header="Mã Đơn Gốc" Binding="{Binding OrderCode}" FontWeight="Bold" Width="130"/>
                            <DataGridTextColumn Header="Vị Trí Kệ Lưu Kho" Binding="{Binding RtoLocationCode}" FontWeight="Bold" Foreground="#059669" Width="130"/>
                            <DataGridTextColumn Header="Ngày Duyệt Hoàn" Binding="{Binding RtoApprovedDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="Bên Gửi (Shop)" Binding="{Binding SenderName}" FontWeight="SemiBold" Width="180"/>
                            <DataGridTextColumn Header="Cước Phí Hoàn" Binding="{Binding ReturnShippingFee, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="#DC2626" Width="110"/>
                            <DataGridTextColumn Header="Bưu Kiện Hoàn" Binding="{Binding ProductSummary}" Width="180"/>
                            <DataGridTextColumn Header="Biên Bản Trả" Binding="{Binding ReturnHandoverBatchCode}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- ================= NHÁNH 6: BIÊN BẢN BÀN GIAO TRẢ SHOP ================= -->
                <StackPanel x:Name="panelBienBanTraShop" Visibility="Collapsed">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Lịch sử các đợt bàn giao trả hàng hoàn cho các Shop / Đối tác gửi hàng" FontSize="13" Foreground="#64748B"/>
                    </Grid>

                    <DataGrid x:Name="dgBienBanTraShop" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="46"
                              Background="White" RowHeaderWidth="0" MinHeight="360" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Biên Bản" Binding="{Binding BatchCode}" FontWeight="Bold" Width="130"/>
                            <DataGridTextColumn Header="Shop / Đối Tác" Binding="{Binding SenderName}" FontWeight="Bold" Width="180"/>
                            <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding SenderPhone}" Width="120"/>
                            <DataGridTextColumn Header="Thời Gian Bàn Giao" Binding="{Binding CreatedTime, StringFormat='HH:mm - dd/MM/yyyy'}" Width="140"/>
                            <DataGridTextColumn Header="Số Kiện Hoàn" Binding="{Binding TotalOrders}" FontWeight="Bold" Width="110"/>
                            <DataGridTextColumn Header="Tổng Cước Hoàn Thu" Binding="{Binding TotalReturnFee, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="#DC2626" Width="140"/>
                            <DataGridTextColumn Header="Thủ Kho Thực Hiện" Binding="{Binding OperatorName}" Width="140"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" FontWeight="Bold" Width="120"/>

                            <DataGridTemplateColumn Header="Thao Tác" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NutThaoTacStyle}" Height="28" Padding="10,0" Background="#EFF6FF" Foreground="#2563EB" Click="BtnInBienBanTraShop_Click">
                                            <TextBlock Text="🖨️ In Biên Bản"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= MODAL 1: LÊN LỊCH PHÁT LẠI (RE-DELIVERY) ================= -->
        <Grid x:Name="modalPhatLai" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="⏱️ LÊN LỊCH HẸN PHÁT LẠI" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Style="{StaticResource NutThaoTacStyle}" Background="Transparent" Foreground="#64748B" FontSize="18" FontWeight="Bold"
                                HorizontalAlignment="Right" Click="BtnDongModalPhatLai_Click">
                            <TextBlock Text="✕"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="txtThongTinDonPhatLai" Text="Mã đơn: LOGIX-98009 • Người nhận: Mai Thế Vinh" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB" Margin="0,0,0,12"/>

                    <TextBlock Text="Ngày Hẹn Phát Lại Tiếp Theo:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpNgayPhatLaiMoi" Height="36" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Khung Giờ Hẹn &amp; Dặn Dò Của Khách:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtGhiChuPhatLai" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" Padding="8,6"
                             Text="Khách dặn phát lại sau 18h tối nay khi đi làm về" BorderBrush="#CBD5E1"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="16,0" Background="#F1F5F9" Foreground="#334155" Margin="0,0,8,0" Click="BtnDongModalPhatLai_Click">
                            <TextBlock Text="Hủy Bỏ"/>
                        </Button>
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="18,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnXacNhanPhatLai_Click">
                            <TextBlock Text="Xác Nhận Hẹn Lại"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 2: DUYỆT CHUYỂN HOÀN (RTO APPROVED) ================= -->
        <Grid x:Name="modalDuyetHoan" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="🔄 DUYỆT CHUYỂN HOÀN VỀ SHOP (RTO)" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                        <Button Style="{StaticResource NutThaoTacStyle}" Background="Transparent" Foreground="#64748B" FontSize="18" FontWeight="Bold"
                                HorizontalAlignment="Right" Click="BtnDongModalDuyetHoan_Click">
                            <TextBlock Text="✕"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="txtThongTinDonDuyetHoan" Text="Mã đơn: LOGIX-98010 • Shop: Gia Dụng Thông Minh" FontWeight="Bold" FontSize="12.5" Foreground="#DC2626" Margin="0,0,0,12"/>

                    <TextBlock Text="Vị Trí Kệ Lưu Kho Hàng Hoàn:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbViTriKeHoan" Height="36" Margin="0,0,0,12" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="KHO-RTO-01 (Kệ Hàng Hoàn Tầng 1)" IsSelected="True"/>
                        <ComboBoxItem Content="KHO-RTO-02 (Kệ Hàng Hoàn Tầng 2)"/>
                        <ComboBoxItem Content="KHO-RTO-EXP (Kệ Hàng Hoàn Giá Trị Cao)"/>
                    </ComboBox>

                    <TextBlock Text="Cước Phí Chuyển Hoàn Thu Của Shop (VNĐ):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCuocPhiHoan" Height="36" Margin="0,0,0,12" Padding="8,0" VerticalContentAlignment="Center" Text="15000" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="Lý Do Phê Duyệt Hoàn:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtLyDoDuyetHoan" Height="50" TextWrapping="Wrap" Margin="0,0,0,16" Padding="8,6"
                             Text="Đã phát 3 lần không liên lạc được, duyệt trả hàng về shop" BorderBrush="#CBD5E1"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="16,0" Background="#F1F5F9" Foreground="#334155" Margin="0,0,8,0" Click="BtnDongModalDuyetHoan_Click">
                            <TextBlock Text="Hủy Bỏ"/>
                        </Button>
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="36" Padding="18,0" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="BtnXacNhanDuyetHoan_Click">
                            <TextBlock Text="Xác Nhận Chuyển Hoàn"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 3: IN BIÊN BẢN BÀN GIAO TRẢ SHOP ================= -->
        <Grid x:Name="modalInBienBan" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="820" MaxHeight="780" Margin="20" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="BIÊN BẢN BÀN GIAO TRẢ HÀNG HOÀN CHO SHOP" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Button Style="{StaticResource NutThaoTacStyle}" Background="Transparent" Foreground="#64748B" FontSize="18" FontWeight="Bold"
                                HorizontalAlignment="Right" Click="BtnDongModalInBienBan_Click">
                            <TextBlock Text="✕"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" x:Name="vungInBienBanTraShop" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LOGIX WMS - SMART LOGISTICS SYSTEM" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                                        <TextBlock Text="Bộ Phận Xử Lý Logistics Ngược &amp; Hàng Hoàn RTO" FontSize="11" Foreground="#475569"/>
                                        <TextBlock Text="Địa chỉ: Số 88 Đường Phạm Hùng, Nam Từ Liêm, Hà Nội" FontSize="10.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtMaBienBanIn" Text="MÃ BIÊN BẢN: BBH-260925-001" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                        <TextBlock x:Name="txtNgayLapBienBanIn" Text="Ngày lập: 25/09/2026" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1.5" Fill="#0F172A" Margin="0,0,0,14"/>

                                <TextBlock Text="BIÊN BẢN BÀN GIAO HÀNG HOÀN TRẢ CHO SHOP / ĐỐI TÁC" 
                                           HorizontalAlignment="Center" FontWeight="ExtraBold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="txtTenShopIn" Text="• Shop đối tác: Gia Dụng Thông Minh" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                            <TextBlock x:Name="txtSdtShopIn" Text="• Số điện thoại: 0919 223 344" FontSize="12" Foreground="#334155" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="txtDiaChiShopIn" Text="• Địa chỉ kho Shop: Số 120 Đường Cầu Giấy, Hà Nội" FontSize="12" Foreground="#334155" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="txtNguoiLapBienBanIn" Text="• Đại diện kho bàn giao: Trần Thị Trưởng Kho" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                            <TextBlock Text="• Trạng thái hàng: Nguyên tem niêm phong, bao bì hoàn trả" FontSize="12" Foreground="#334155" Margin="0,3,0,0"/>
                                            <TextBlock Text="• Hình thức trả: Nhận hàng trực tiếp tại quầy bưu cục" FontSize="12" Foreground="#334155" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="DANH SÁCH BƯU KIỆN HOÀN TRẢ:" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>

                                <DataGrid x:Name="dgChiTietBienBanIn" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All"
                                          BorderThickness="1" BorderBrush="#CBD5E1" RowHeight="36"
                                          Background="White" RowHeaderWidth="0" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã RTO" Binding="{Binding RtoTrackingCode}" FontWeight="Bold" Width="130"/>
                                        <DataGridTextColumn Header="Mã Đơn Gốc" Binding="{Binding OrderCode}" Width="120"/>
                                        <DataGridTextColumn Header="Bưu Kiện Hoàn" Binding="{Binding ProductSummary}" Width="160"/>
                                        <DataGridTextColumn Header="Người Mua Từ Chối" Binding="{Binding ReceiverName}" Width="130"/>
                                        <DataGridTextColumn Header="Cước Hoàn Phải Thu" Binding="{Binding ReturnShippingFee, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="#DC2626" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="#FEF3C7" CornerRadius="6" Padding="12,8" Margin="0,12,0,16" BorderBrush="#FDE68A" BorderThickness="1">
                                    <TextBlock x:Name="txtTongKetBienBanIn" Text="TỔNG SỐ KIỆN HOÀN: 1 Kiện | TỔNG CƯỚC HOÀN SHOP PHẢI TRẢ: 15.000 đ" 
                                               FontWeight="Bold" FontSize="12.5" Foreground="#92400E"/>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="ĐẠI DIỆN KHO BÀN GIAO" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                                        <TextBlock Text="(Ký và ghi rõ họ tên)" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="[ĐÃ XUẤT KHO HOÀN]" Margin="0,35,0,0" FontSize="11" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="ĐẠI DIỆN SHOP NHẬN HÀNG" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                                        <TextBlock Text="(Xác nhận nhận đủ kiện &amp; trả cước)" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="[ĐÃ NHẬN ĐỦ HÀNG]" Margin="0,35,0,0" FontSize="11" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="16,0" Background="#F1F5F9" Foreground="#334155" Margin="0,0,10,0" Click="BtnDongModalInBienBan_Click">
                            <TextBlock Text="Đóng"/>
                        </Button>
                        <Button Style="{StaticResource NutThaoTacStyle}" Height="38" Padding="20,0" Background="#059669" Foreground="White" FontWeight="Bold" Click="BtnThucHienInBienBan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,6,0"/>
                                <TextBlock Text="In Biên Bản / Xuất File PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
