                                <TextBlock Text="BƯU KIỆN KHÁCH LẺ (QUẦY)" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                <TextBlock x:Name="txtTotalRetailParcels" Text="8 kiện" FontSize="20" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,0"/>
                                <TextBlock Text="Đã dán tem &amp; chuyển điều phối" FontSize="10.5" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- Tổng khối lượng nhập -->
