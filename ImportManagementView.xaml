                                    <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="XÁC NHẬN NHẬP KHO XE TẢI &amp; TỰ ĐỘNG ĐẨY ĐIỀU PHỐI" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
