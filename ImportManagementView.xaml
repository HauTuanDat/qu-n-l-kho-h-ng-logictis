                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cân Thực (kg) *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailWeight" Style="{StaticResource ModernTextBoxStyle}" Text="" TextChanged="RetailInputs_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dài (cm) *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailLength" Style="{StaticResource ModernTextBoxStyle}" Text="" TextChanged="RetailInputs_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Rộng (cm) *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailWidth" Style="{StaticResource ModernTextBoxStyle}" Text="" TextChanged="RetailInputs_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Cao (cm) *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailHeight" Style="{StaticResource ModernTextBoxStyle}" Text="" TextChanged="RetailInputs_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- HỘP TỰ ĐỘNG TÍNH THỂ TÍCH THEO CHUẨN LOGISTICS -->
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📐 QUY ĐỔI THỂ TÍCH (CHUẨN D x R x C / 5000):" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                        <TextBlock x:Name="txtVolumetricFormula" Text="• Vui lòng nhập trọng lượng và kích thước để tính thể tích..." FontSize="11.5" Foreground="#B45309" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="txtBillableWeightText" Text="• Trọng lượng tính cước: 0.0 kg (Chờ cân đo)" FontSize="12" FontWeight="Bold" Foreground="#78350F" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- GÓI DỊCH VỤ -->
                                <TextBlock Text="Gói Dịch Vụ Vận Chuyển *" Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="rbRetailStandardService" Content="📦 Tiêu Chuẩn (24-48h)" IsChecked="True" Margin="0,0,14,0" Checked="RetailInputs_Changed"/>
                                    <RadioButton x:Name="rbRetailExpressService" Content="⚡ Hỏa Tốc Express (2-4h)" Foreground="#7C3AED" FontWeight="Bold" Checked="RetailInputs_Changed"/>
                                </StackPanel>

                                <!-- PHỤ PHÍ DỊCH VỤ -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox x:Name="chkRetailFragile" Content="Bảo hiểm Dễ Vỡ (+10k)" Margin="0,0,12,0" Checked="RetailInputs_Changed" Unchecked="RetailInputs_Changed"/>
                                    <CheckBox x:Name="chkRetailHighValue" Content="Khai Giá Cao (+15k)" Checked="RetailInputs_Changed" Unchecked="RetailInputs_Changed"/>
                                </StackPanel>

                                <!-- THẺ GỢI Ý VỊ TRÍ LƯU KỆ CHO KHÁCH LẺ -->
                                <Border x:Name="borderRetailPutAway" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="🧠 GỢI Ý VỊ TRÍ XẾP KỆ (SMART PUT-AWAY):" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        <TextBlock x:Name="txtRetailPutAwaySuggestion" Text="Khuyên đặt: Chờ nhập trọng lượng và loại hàng để gợi ý vị trí ô kệ." FontSize="11.5" Foreground="#1E40AF" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CỘT 3: BẢNG TÍNH CƯỚC & THANH TOÁN -->
                        <Border Grid.Column="4" Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <TextBlock Text="3. BẢNG TÍNH CƯỚC &amp; THANH TOÁN" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <TextBlock Text="Số Tiền Thu Hộ COD (VNĐ)" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="txtRetailCodAmount" Style="{StaticResource ModernTextBoxStyle}" Text="0" Margin="0,0,0,10" TextChanged="RetailInputs_Changed"/>

                                <!-- BẢNG CHI TIẾT CƯỚC -->
