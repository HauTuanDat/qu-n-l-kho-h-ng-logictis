                            <ColumnDefinition Width="3.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="3.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="3.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT 1: THÔNG TIN BÊN GỬI & BÊN NHẬN -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <TextBlock Text="1. THÔNG TIN BÊN GỬI &amp; BÊN NHẬN" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <!-- Người gửi -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="BÊN GỬI HÀNG (SENDER)" FontSize="11" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Họ Tên Người Gửi *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailSenderName" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                        <TextBlock Text="Số Điện Thoại Gửi * (10 chữ số)" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailSenderPhone" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                        <TextBlock Text="Địa Chỉ Người Gửi *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailSenderAddress" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>
                                    </StackPanel>
                                </Border>

                                <!-- Người nhận -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="BÊN NHẬN HÀNG (RECEIVER)" FontSize="11" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,6"/>
                                        <TextBlock Text="Họ Tên Người Nhận *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailReceiverName" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                        <TextBlock Text="Số Điện Thoại Nhận * (10 chữ số)" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailReceiverPhone" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                        <TextBlock Text="Địa Chỉ Giao Hàng Chi Tiết *" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox x:Name="txtRetailReceiverAddress" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                        <TextBlock Text="Tỉnh / Thành Phố Giao Đến *" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox x:Name="cbRetailDestinationArea" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0" SelectionChanged="ControlValue_ClearedError">
                                            <ComboBoxItem Content="-- Chọn Tỉnh / Thành Phố Giao Đến --"/>
                                            <ComboBoxItem Content="Thái Nguyên (TP Thái Nguyên)"/>
                                            <ComboBoxItem Content="Thái Nguyên (Sông Công - Phổ Yên)"/>
                                            <ComboBoxItem Content="Hà Nội (Nội thành)"/>
                                            <ComboBoxItem Content="Hà Nội (Ngoại thành)"/>
                                            <ComboBoxItem Content="Hải Phòng"/>
                                            <ComboBoxItem Content="Bắc Ninh"/>
                                            <ComboBoxItem Content="Đà Nẵng"/>
                                            <ComboBoxItem Content="TP. Hồ Chí Minh"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CỘT 2: THÔNG TIN BƯU KIỆN & CÂN ĐO THỂ TÍCH -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <TextBlock Text="2. QUY CÁCH BƯU KIỆN &amp; THỂ TÍCH" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <TextBlock Text="Mô Tả Bưu Kiện / Gói Hàng Gửi *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="txtRetailProductName" Style="{StaticResource ModernTextBoxStyle}" Text="" Margin="0,0,0,8" TextChanged="ControlValue_ClearedError"/>

                                <TextBlock Text="Phân Loại Bưu Kiện *" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox x:Name="cbRetailProductType" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="RetailInputs_Changed">
                                    <ComboBoxItem Content="📦 Hàng Tiêu Chuẩn Thông Thường"/>
                                    <ComboBoxItem Content="🍷 Hàng Dễ Vỡ (Cần Bọc Xốp Cẩn Thận)"/>
                                    <ComboBoxItem Content="💎 Hàng Giá Trị Cao (Điện Tử / Điện Thoại)"/>
                                    <ComboBoxItem Content="📄 Tài Liệu / Giấy Tờ Hợp Đồng"/>
                                </ComboBox>

                                <!-- KÍCH THƯỚC VÀ CÂN NẶNG: MẶC ĐỊNH RỖNG ĐỂ KIỂM ĐẾM THỰC TẾ -->
