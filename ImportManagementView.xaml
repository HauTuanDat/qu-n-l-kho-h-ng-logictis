                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Tiếp nhận bưu kiện tại quầy: Nhập cân nặng &amp; kích thước D x R x C hệ thống tự tính trọng lượng thể tích và cước phí. Khi bấm lưu, đơn hàng tự động xuất hiện ở Gom Tuyến &amp; Điều Phối Shipper!" FontSize="12" Foreground="#86198F" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="btnFillSampleRetail" Style="{StaticResource ChipButtonStyle}" Background="#FAE8FF" BorderBrush="#F0ABFC" Foreground="#A21CAF" Click="BtnFillSampleRetail_Click">
