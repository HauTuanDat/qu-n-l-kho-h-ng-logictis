                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Cước vận chuyển chính:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtRetailShippingFee" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Phụ phí (Hỏa tốc / Dễ vỡ):" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtRetailSurcharge" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Tiền thu hộ COD:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtRetailCodDisplay" Text="0 đ" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,4,0,8"/>
                                        <Grid>
                                            <TextBlock Text="TỔNG TIỀN KHÁCH TRẢ:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtRetailTotalAmount" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NGƯỜI CHỊU CƯỚC -->
                                <TextBlock Text="Bên Chịu Cước Vận Chuyển *" Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Margin="0,0,0,10">
                                    <RadioButton x:Name="rbRetailSenderPays" Content="Người gửi trả ngay tại quầy" Margin="0,0,0,4" Checked="RetailInputs_Changed"/>
                                    <RadioButton x:Name="rbRetailReceiverPays" Content="Khách nhận trả (Cộng cước vào thu COD)" IsChecked="True" Checked="RetailInputs_Changed"/>
                                </StackPanel>

                                <!-- HÌNH THỨC THANH TOÁN -->
                                <TextBlock Text="Phương Thức Thanh Toán *" Style="{StaticResource FormLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="rbRetailPayCash" Content="💵 Tiền Mặt" IsChecked="True" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="rbRetailPayQR" Content="📱 Quét Mã VietQR / MoMo"/>
                                </StackPanel>

                                <!-- CẢNH BÁO KIỂM TRA DỮ LIỆU ĐẦU VÀO KHÁCH LẺ -->
                                <Border x:Name="borderRetailValidationAlert" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="THIẾU THÔNG TIN BẮT BUỘC (*):" FontSize="11.5" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtRetailValidationDetails" Text="" FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap" Margin="16,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- NÚT HÀNH ĐỘNG -->
                                <Button x:Name="btnSaveRetailInbound" Style="{StaticResource PrimaryButtonStyle}" Background="#2563EB" Height="42" Margin="0,0,0,8" Click="BtnSaveRetailInbound_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" Margin="0,0,6,0"/>
                                        <TextBlock Text="LƯU ĐƠN NHẬP KHO &amp; ĐẨY ĐIỀU PHỐI" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="btnPrintRetailThermalLabel" Style="{StaticResource NutCongCuTintedStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#475569" Height="34" Click="BtnPrintRetailThermalLabel_Click">
                                        <TextBlock Text="🏷️ In Tem (100x150)"/>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="btnResetRetailForm" Style="{StaticResource NutCongCuTintedStyle}" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#475569" Height="34" Click="BtnResetRetailForm_Click">
                                        <TextBlock Text="🔄 Xóa Trắng Form"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- PHÂN HỆ TAB 3: SỔ NHẬT KÝ NHẬP KHO & LỊCH SỬ LÔ HÀNG (HISTORY & AUDIT)     -->
                <!-- ========================================================================= -->
                <StackPanel x:Name="panelHistoryInbound" Visibility="Collapsed">
                    <!-- 4 THẺ KPI TỔNG HỢP -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tổng số phiếu nhập -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TỔNG SỐ PHIẾU NHẬP" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTotalImportOrders" Text="12 phiếu" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                <TextBlock Text="Bao gồm xe tải &amp; khách lẻ" FontSize="10.5" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- Xe tải trung chuyển -->
                        <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CHUYẾN XE TẢI TRUNG CHUYỂN" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                <TextBlock x:Name="txtTotalTruckBatches" Text="4 chuyến" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                                <TextBlock Text="Tiếp nhận tại các cửa dock" FontSize="10.5" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

